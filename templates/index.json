      "type": "dc-faq",
      "blocks": {
        "faq-1": {
          "type": "question",
          "settings": {
            "question": "Are your products clinically tested?",
            "answer": "<p>Our formulations are developed using clinically supported ingredients and grounded in dermatological science. We prioritize evidence-based actives known for their efficacy, safety, and skin compatibility.</p>"
          }
        },
        "faq-2": {
          "type": "question",
          "settings": {
            "question": "Do your products really contain 24K gold?",
            "answer": "<p>Absolutely. We use pure 24K gold in our skincare formulations, carefully blended with advanced active ingredients to enhance radiance and support youthful-looking skin.</p>"
          }
        },
        "faq-3": {
          "type": "question",
          "settings": {
            "question": "How long will it take to see results?",
            "answer": "<p>Many customers notice an instant glow and smoother texture after the first application. Long-term results, such as improved elasticity and reduced fine lines, are typically seen within 4–6 weeks of consistent use.</p>"
          }
        },
        "faq-4": {
          "type": "question",
          "settings": {
            "question": "Can I use your products with other brands?",
            "answer": "<p>Yes, Dévoué products are designed to integrate seamlessly into your existing routine. For optimal results and a fully elevated experience, we recommend using them as part of the complete L’Or Celeste Ritual.</p>"
          }
        }
      },
      "block_order": ["faq-1", "faq-2", "faq-3", "faq-4"],
