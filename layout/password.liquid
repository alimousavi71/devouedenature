<!doctype html>
<html class="no-js full-height" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>
    <meta name="description" content="{{ page_description | escape }}">
    {% render 'meta-tags' %}
    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
  </head>
  <body class="bg-bg text-ink antialiased min-h-screen flex flex-col">
    <main id="MainContent" class="flex-1 flex flex-col items-center justify-center px-5 py-16" role="main">
      <a href="{{ routes.root_url }}" class="font-display text-h2 mb-10">{{ shop.name }}</a>
      {{ content_for_layout }}
    </main>
    <script src="{{ 'theme.js' | asset_url }}" defer="defer"></script>
  </body>
</html>
