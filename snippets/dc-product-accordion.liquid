{%- comment -%}
  Product PDP accordion — redesign/Product.dc.html (lines 132–142)
  Params: heading, body, open, class
{%- endcomment -%}
{%- if heading != blank -%}
  <details class="dc-accordion dc-accordion--product border-b border-border {{ class }}" {% if open %}open{% endif %}>
    <summary class="dc-accordion__summary">
      <span class="dc-accordion__title">{{ heading }}</span>
      <span class="dc-accordion__icon" aria-hidden="true">+</span>
    </summary>
    <div class="dc-accordion__body">
      <div class="dc-accordion__content">
        <div class="dc-accordion__inner">
          {{ body }}
        </div>
      </div>
    </div>
  </details>
{%- endif -%}
