{%- comment -%}
  Home lineup product card — pixel match redesign/Home.dc.html lines 75–82.
  Params:
    card_product  - {Object} required
{%- endcomment -%}
{%- liquid
  assign family_label = card_product.metafields.custom.family.value | default: card_product.metafields.custom.family | default: card_product.type
  if family_label == blank and card_product.collections.first.title != blank
    assign family_label = card_product.collections.first.title
  endif
-%}
<a
  href="{{ card_product.url }}"
  class="dc-lineup-card group block"
  data-dc-card-hover
>
  <div class="dc-lineup-card__media relative aspect-[4/5] bg-ink flex items-center justify-center overflow-hidden">
    {%- if card_product.featured_image -%}
      {{
        card_product.featured_image
        | image_url: width: 800
        | image_tag:
          loading: 'lazy',
          class: 'dc-lineup-card__img absolute inset-0 w-full h-full object-cover',
          alt: card_product.title,
          widths: '400, 600, 800',
          sizes: '(min-width: 768px) 20vw, 50vw'
      }}
    {%- else -%}
      <span class="font-mono text-[9px] tracking-[0.14em] uppercase text-gold">
        packshot on dark
      </span>
    {%- endif -%}

    {%- if family_label != blank -%}
      <span class="dc-lineup-card__badge absolute top-[14px] left-[14px] z-[1] font-body text-[8px] leading-none tracking-[0.24em] uppercase text-gold">
        {{ family_label }}
      </span>
    {%- endif -%}
  </div>

  <div class="dc-lineup-card__meta mt-[16px]">
    <div class="font-body text-[12px] tracking-[0.1em] text-ink">{{ card_product.title }}</div>
    <div class="mt-[6px] font-body text-[12px] text-secondary">{{ card_product.price | money }}</div>
  </div>
</a>
