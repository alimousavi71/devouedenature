{%- comment -%}
  Product gallery — thumbnail rail + main stage (image / video / external video) + lightbox.
  Accepts: product
{%- endcomment -%}

{%- liquid
  assign featured = product.featured_media
  assign featured_type = featured.media_type | default: 'image'
  assign featured_alt = featured.alt | default: product.title | escape
-%}

<div data-dc-gallery-wrap>
  <div class="grid grid-cols-1 md:grid-cols-[64px_minmax(0,1fr)] gap-[28px] items-start" data-dc-gallery>
    <div class="hidden md:flex flex-col gap-3 sticky top-[120px] self-start max-h-[calc(100vh-140px)] overflow-y-auto">
      {%- for media in product.media -%}
        {% render 'dc-product-gallery-thumb', media: media, product: product, index: forloop.index0, active: forloop.first %}
      {%- endfor -%}
    </div>

    <div class="min-w-0">
      <div
        data-dc-gallery-main
        class="dc-gallery-main relative w-full aspect-[4/5] overflow-hidden bg-gradient-to-br from-[#F8F3E8] to-[#E7E3DB]"
        data-media-type="{{ featured_type }}"
      >
        {%- if featured != blank -%}
          {%- assign featured_preview = featured.preview_image | default: featured -%}

          <div
            data-dc-gallery-image-stack
            class="absolute inset-0 {% unless featured_type == 'image' %}invisible opacity-0 pointer-events-none{% endunless %}"
          >
            <img
              src="{{ featured_preview | image_url: width: 1400 }}"
              srcset="{{ featured_preview | image_url: width: 700 }} 700w, {{ featured_preview | image_url: width: 1000 }} 1000w, {{ featured_preview | image_url: width: 1400 }} 1400w"
              sizes="(min-width: 1024px) 55vw, 100vw"
              width="{{ featured_preview.width }}"
              height="{{ featured_preview.height }}"
              loading="eager"
              decoding="async"
              class="dc-gallery-layer absolute inset-0 w-full h-full object-cover"
              alt="{{ featured_alt }}"
              data-dc-gallery-img
              data-dc-gallery-active
            >
            <img
              class="dc-gallery-layer absolute inset-0 w-full h-full object-cover opacity-0 pointer-events-none"
              data-dc-gallery-img
              alt=""
              aria-hidden="true"
              decoding="async"
            >
          </div>

          <video
            data-dc-gallery-video
            class="dc-gallery-video absolute inset-0 w-full h-full object-cover {% unless featured_type == 'video' %}hidden{% endunless %}"
            playsinline
            muted
            loop
            controls
            preload="metadata"
            {% if featured_preview != blank %}poster="{{ featured_preview | image_url: width: 1400 }}"{% endif %}
            {% if featured_type == 'video' %}autoplay{% endif %}
          >
            {%- if featured_type == 'video' -%}
              {%- for source in featured.sources -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endfor -%}
            {%- endif -%}
          </video>

          <div
            data-dc-gallery-external
            class="dc-gallery-external absolute inset-0 {% unless featured_type == 'external_video' %}hidden{% endunless %}"
          >
            {%- if featured_type == 'external_video' -%}
              {{
                featured
                | external_video_tag:
                  class: 'absolute inset-0 w-full h-full',
                  loading: 'lazy'
              }}
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="absolute inset-0 bg-[repeating-linear-gradient(135deg,rgba(48,39,29,0.035)_0_14px,rgba(48,39,29,0)_14px_28px)]" aria-hidden="true"></div>
        {%- endif -%}

        <button
          type="button"
          data-dc-gallery-zoom
          class="dc-gallery-zoom absolute inset-0 z-[2] border-0 p-0 bg-transparent text-left cursor-zoom-in {% unless featured_type == 'image' %}hidden{% endunless %}"
          aria-label="{{ 'products.product.media.zoom' | t | default: 'Zoom product image' }}"
        >
          <span class="absolute bottom-[18px] right-5 z-[1] font-body text-[10px] tracking-[0.2em] uppercase text-muted pointer-events-none">
            {{ 'products.product.media.zoom' | t | default: 'Zoom' }}
          </span>
        </button>
      </div>

      {%- if product.media.size > 0 -%}
        <div class="flex md:hidden gap-3 mt-3 overflow-x-auto pb-1 -mx-[20px] px-[20px] md:mx-0 md:px-0">
          {%- for media in product.media -%}
            {% render 'dc-product-gallery-thumb', media: media, product: product, index: forloop.index0, active: forloop.first %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if product.media.size > 0 -%}
    <div
      data-dc-gallery-lightbox
      class="dc-gallery-lightbox hidden"
      aria-hidden="true"
    >
      <div
        data-dc-gallery-lightbox-scrim
        class="dc-gallery-lightbox__scrim absolute inset-0 opacity-0"
        aria-hidden="true"
      ></div>

      <div
        data-dc-gallery-lightbox-panel
        role="dialog"
        aria-modal="true"
        aria-label="{{ 'products.product.media.gallery' | t | default: 'Product gallery' }}"
        class="dc-gallery-lightbox__panel relative z-[1] flex h-full w-full flex-col"
      >
        <header class="dc-gallery-lightbox__header absolute inset-x-0 top-0 z-20 flex justify-end px-5 pt-5 md:px-10 md:pt-10">
          <button
            type="button"
            data-dc-gallery-lightbox-close-btn
            class="dc-gallery-lightbox__close font-body text-[10px] tracking-[0.2em] uppercase"
          >
            {{ 'general.close' | t | default: 'Close' }}
          </button>
        </header>

        <div class="dc-gallery-lightbox__stage relative flex flex-1 items-center justify-center px-12 pb-20 pt-14 md:px-16 md:pb-24 md:pt-16">
          <button
            type="button"
            data-dc-gallery-lightbox-prev
            class="dc-gallery-lightbox__arrow dc-gallery-lightbox__arrow--prev {% if product.media.size < 2 %}hidden{% endif %}"
            aria-label="{{ 'general.pagination.previous' | t | default: 'Previous' }}"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
              <path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>

          <div
            data-dc-gallery-lightbox-track
            class="dc-gallery-lightbox__track relative w-full max-w-[min(100%,1400px)] max-h-[calc(100dvh-128px)] aspect-[4/5] md:aspect-auto md:h-[calc(100dvh-128px)] overflow-hidden"
          >
            <img
              data-dc-gallery-lightbox-img
              data-dc-gallery-lightbox-active
              class="dc-gallery-lightbox__img absolute inset-0 w-full h-full object-contain will-change-transform"
              alt=""
              decoding="async"
            >
            <img
              data-dc-gallery-lightbox-img
              class="dc-gallery-lightbox__img absolute inset-0 w-full h-full object-contain opacity-0 pointer-events-none will-change-transform"
              alt=""
              aria-hidden="true"
              decoding="async"
            >
            <video
              data-dc-gallery-lightbox-video
              class="dc-gallery-lightbox__video absolute inset-0 w-full h-full object-contain hidden"
              playsinline
              controls
              loop
            ></video>
            <div
              data-dc-gallery-lightbox-external
              class="dc-gallery-lightbox__external absolute inset-0 hidden"
            ></div>
          </div>

          <button
            type="button"
            data-dc-gallery-lightbox-next
            class="dc-gallery-lightbox__arrow dc-gallery-lightbox__arrow--next {% if product.media.size < 2 %}hidden{% endif %}"
            aria-label="{{ 'general.pagination.next' | t | default: 'Next' }}"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true">
              <path d="M9 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>

        <div
          data-dc-gallery-lightbox-nav
          class="absolute inset-x-0 bottom-0 z-10 flex items-center justify-center px-5 pb-5 md:px-10 md:pb-8 {% if product.media.size < 2 %}hidden{% endif %}"
        >
          <span
            data-dc-gallery-lightbox-counter
            class="font-mono text-[10px] tracking-[0.12em] uppercase text-bg/75"
            aria-live="polite"
          ></span>
        </div>
      </div>
    </div>
  {%- endif -%}
</div>
