{%- comment -%}
  Breadcrumbs — redesign-aligned trail. Shown when settings.show_breadcrumbs.
{%- endcomment -%}

{%- unless template.name == 'index' or template.name == 'list-collections' or template.name == 'cart' or template.name == 'search' or template.name == '404' or template.suffix == 'contact' or template.name == 'collection' or template.name == 'product' -%}
  <nav
    class="max-w-page mx-auto px-5 md:px-10 pt-6 font-mono text-caption uppercase text-muted"
    aria-label="{{ 'general.breadcrumbs.home' | t | default: 'Breadcrumb' }}"
  >
    <ol class="flex flex-wrap items-center gap-2 list-none m-0 p-0">
      <li>
        <a href="{{ routes.root_url }}" class="hover:text-ink transition-colors duration-fast ease-fast">
          {{ 'general.breadcrumbs.home' | t | default: 'Home' }}
        </a>
      </li>

      {%- comment -%}
        Product + collection trails live in their own sections
        (dc-product / dc-collection-banner) to match redesign.
      {%- endcomment -%}

      {%- if template.name == 'article' -%}
        <li aria-hidden="true">/</li>
        <li>
          <a href="{{ blog.url }}" class="hover:text-ink transition-colors duration-fast ease-fast">{{ blog.title }}</a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">{{ article.title }}</li>

      {%- elsif template.name == 'blog' -%}
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">{{ blog.title }}</li>

      {%- elsif template.name == 'page' -%}
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">{{ page.title }}</li>

      {%- elsif template.name == 'customers' -%}
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">{{ page_title }}</li>

      {%- else -%}
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">{{ page_title }}</li>
      {%- endif -%}
    </ol>
  </nav>
{%- endunless -%}
