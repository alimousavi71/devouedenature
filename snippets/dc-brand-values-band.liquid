{%- comment -%}
  Brand values grid — shared by dc-brand-values and dc-announcement (legacy home section).
  Pass: section
{%- endcomment -%}

{%- liquid
  assign values_heading = section.settings.heading | default: 'Thoughtfully made in Canada'
  if values_heading == 'Official launch'
    assign values_heading = 'Thoughtfully made in Canada'
  endif
  assign value_blocks = section.blocks | where: 'type', 'value'
-%}

{%- unless section.settings.hide_section -%}
  <section class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 py-[64px] md:py-[90px] xl:py-[130px]">
    {%- if values_heading != blank -%}
      <h2 class="dc-brand-values__heading font-display font-normal text-[28px] md:text-[40px] leading-[1.15] text-ink m-0 mx-auto text-center" data-reveal>
        {{ values_heading }}
      </h2>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <p class="dc-prose dc-brand-values__intro mt-4 md:mt-5 mx-auto max-w-[min(100%,52rem)] md:max-w-[78ch] text-center font-body text-[14px] md:text-[15px] leading-[1.95] text-secondary m-0 px-1" data-reveal>
        {{ section.settings.intro | escape }}
        {%- if section.settings.show_intro_maple_leaf -%}
          {% render 'dc-maple-leaf', inline: true %}
        {%- endif -%}
      </p>
    {%- endif -%}

    {%- if value_blocks.size > 0 -%}
      <div
        class="mt-[34px] md:mt-[46px] grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[30px] py-[40px] md:py-[50px] border-y border-border"
        data-reveal-stagger
      >
        {%- for block in value_blocks -%}
          <div class="text-center px-[10px]" data-dc-lift-hover {{ block.shopify_attributes }}>
            {% render 'dc-claim-mark',
              icon: block.settings.icon,
              icon_svg: block.settings.icon_svg,
              mark: block.settings.mark
            %}
            {%- if block.settings.title != blank -%}
              <p class="mt-6 font-body text-[11px] tracking-[0.2em] uppercase text-ink m-0">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="mt-3 mx-auto font-body text-[12px] leading-[1.8] text-secondary max-w-[26ch] m-0">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div
        class="mt-[34px] md:mt-[46px] grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[30px] py-[40px] md:py-[50px] border-y border-border"
        data-reveal-stagger
      >
        <div class="text-center px-[10px]" data-dc-lift-hover>
          {% render 'dc-claim-mark', mark: 'maple_leaf' %}
          <p class="mt-6 font-body text-[11px] tracking-[0.2em] uppercase text-ink m-0">Made in Canada</p>
          <p class="mt-3 mx-auto font-body text-[12px] leading-[1.8] text-secondary max-w-[26ch] m-0">Formulated and filled with precision in Canada.</p>
        </div>
        <div class="text-center px-[10px]" data-dc-lift-hover>
          {% render 'dc-claim-mark', mark: 'diamond' %}
          <p class="mt-6 font-body text-[11px] tracking-[0.2em] uppercase text-ink m-0">Physician formulated</p>
          <p class="mt-3 mx-auto font-body text-[12px] leading-[1.8] text-secondary max-w-[26ch] m-0">Developed by a collective of physicians and scientists.</p>
        </div>
        <div class="text-center px-[10px]" data-dc-lift-hover>
          {% render 'dc-claim-mark', mark: 'square' %}
          <p class="mt-6 font-body text-[11px] tracking-[0.2em] uppercase text-ink m-0">Clinically tested</p>
          <p class="mt-3 mx-auto font-body text-[12px] leading-[1.8] text-secondary max-w-[26ch] m-0">Assessed for safety, tolerance, and performance.</p>
        </div>
        <div class="text-center px-[10px]" data-dc-lift-hover>
          {% render 'dc-claim-mark', mark: 'circle' %}
          <p class="mt-6 font-body text-[11px] tracking-[0.2em] uppercase text-ink m-0">Cruelty-free</p>
          <p class="mt-3 mx-auto font-body text-[12px] leading-[1.8] text-secondary max-w-[26ch] m-0">No animal testing at any stage, in any market.</p>
        </div>
      </div>
    {%- endif -%}
  </section>
{%- endunless -%}
