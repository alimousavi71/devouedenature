{%- comment -%}
  Reusable article card. Net-new, styled per redesign/Blog.dc.html.
  Usage: {% render 'dc-article-card', card_article: article %}
{%- endcomment -%}
{%- liquid
  assign words = card_article.content | strip_html | split: ' ' | size
  assign read_minutes = words | divided_by: 200 | at_least: 1
-%}
<a href="{{ card_article.url }}" class="group block" {% if data_reveal %}data-reveal="1"{% endif %}>
  <div class="relative aspect-[4/3] bg-elevated overflow-hidden">
    {%- if card_article.image -%}
      {{ card_article.image | image_url: width: 800 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover', alt: card_article.title }}
    {%- endif -%}
  </div>
  <div class="mt-4 flex gap-3 font-mono text-caption uppercase text-muted">
    {%- if card_article.tags.size > 0 -%}<span>{{ card_article.tags.first }}</span>{%- endif -%}
    <span>{{ read_minutes }} min</span>
  </div>
  <h3 class="mt-3 font-display text-h3 text-ink group-hover:text-secondary transition-colors duration-fast ease-fast">{{ card_article.title }}</h3>
  {%- if card_article.excerpt != blank -%}
    <p class="mt-2 font-body text-body text-secondary max-w-[36ch]">{{ card_article.excerpt | strip_html | truncate: 90 }}</p>
  {%- endif -%}
  <p class="mt-3 font-body text-body-sm text-muted">{{ card_article.published_at | date: '%-d %B %Y' }}</p>
</a>
