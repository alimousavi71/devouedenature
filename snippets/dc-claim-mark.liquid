{%- comment -%}
  Claim icon — dynamic SVG / image with geometric preset fallback.
  Params:
    icon      - {Image} uploaded icon (SVG or PNG)
    icon_svg  - {String} inline SVG markup (optional)
    mark      - {String} 'circle' | 'diamond' | 'square' (fallback preset)
{%- endcomment -%}
{%- liquid
  assign mark = mark | default: 'circle'
-%}

{%- if icon_svg != blank -%}
  <div class="dc-claim-mark dc-claim-mark--custom" aria-hidden="true">
    {{ icon_svg }}
  </div>
{%- elsif icon != blank -%}
  {{
    icon
    | image_url: width: 96
    | image_tag:
      width: 24,
      height: 24,
      class: 'dc-claim-mark dc-claim-mark--image',
      loading: 'lazy',
      alt: ''
  }}
{%- else -%}
  <span class="dc-claim-mark dc-claim-mark--preset" aria-hidden="true">
    {%- case mark -%}
      {%- when 'diamond' -%}
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2.5" y="2.5" width="11" height="11" stroke="currentColor" transform="rotate(45 8 8)"/>
        </svg>
      {%- when 'square' -%}
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <rect x="2" y="2" width="12" height="12" stroke="currentColor"/>
        </svg>
      {%- when 'maple_leaf' -%}
        <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M12 2.5C12 2.5 9.25 5.75 8.25 9.25C7.5 10.75 7.75 12.75 9.25 13.75C9.75 11.75 10.75 10.75 12 10.75C13.25 10.75 14.25 11.75 14.75 13.75C16.25 12.75 16.5 10.75 15.75 9.25C14.75 5.75 12 2.5 12 2.5Z" stroke="currentColor" stroke-width="1.2" stroke-linejoin="round"/>
          <path d="M12 10.75V20.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round"/>
          <path d="M9.5 16.5L12 18.5L14.5 16.5" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      {%- else -%}
        <svg viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="8" cy="8" r="7" stroke="currentColor"/>
        </svg>
    {%- endcase -%}
  </span>
{%- endif -%}
