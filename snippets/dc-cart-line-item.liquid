{%- comment -%}
  Cart drawer line item — redesign/Overlays.dc.html (66px | 1fr | auto grid).
  Server-rendered from `item`. src/js/shopify/cart.js mirrors this markup.
  Params: item {Object} — a cart.items[n] object
{%- endcomment -%}
<li class="dc-cart-line grid grid-cols-[66px_minmax(0,1fr)_auto] gap-[18px] py-[18px]" data-dc-cart-line data-dc-drawer-item data-key="{{ item.key }}">
  <a href="{{ item.url }}" class="block w-[66px] aspect-[4/5] shrink-0 bg-elevated overflow-hidden">
    {%- if item.image -%}
      {{ item.image | image_url: width: 132 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover' }}
    {%- endif -%}
  </a>

  <div class="min-w-0 flex flex-col">
    <div class="flex items-start justify-between gap-2">
      <a href="{{ item.url }}" class="font-display text-[17px] leading-[1.2] text-ink hover:text-secondary transition-colors duration-fast ease-fast line-clamp-2">
        {{ item.product_title }}
      </a>
      <button type="button" data-dc-cart-remove aria-label="{{ 'sections.cart.remove_title' | t | default: 'Remove' }}" class="shrink-0 -mt-0.5 font-body text-[18px] leading-none text-secondary hover:text-ink transition-colors duration-fast ease-fast">
        &times;
      </button>
    </div>

    {%- if item.variant_title != blank and item.variant_title != 'Default Title' -%}
      <p class="mt-1.5 font-body text-[11px] text-secondary">{{ item.variant_title }}</p>
    {%- endif -%}

    {%- for property in item.properties -%}
      {%- if property.last != blank -%}
        <p class="font-mono text-caption text-muted">{{ property.first }}: {{ property.last }}</p>
      {%- endif -%}
    {%- endfor -%}

    {% render 'dc-qty-stepper-cart', quantity: item.quantity, class: 'mt-[10px]' %}
  </div>

  <span data-dc-line-price class="shrink-0 font-body text-[13px] text-ink pt-0.5">{{ item.final_line_price | money }}</span>
</li>
