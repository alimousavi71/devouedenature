{%- comment -%}
  Password-page newsletter signup — lightweight replacement for the old
  newsletter section. Used by templates/password.json.
{%- endcomment -%}

<div class="w-full max-w-md text-center">
  {%- if section.settings.heading != blank -%}
    <h1 class="font-display text-h2 mb-4">{{ section.settings.heading }}</h1>
  {%- endif -%}
  {%- if section.settings.text != blank -%}
    <div class="font-body text-body text-secondary mb-8">{{ section.settings.text }}</div>
  {%- endif -%}

  {% form 'customer', class: 'flex flex-col gap-3' %}
    <input type="hidden" name="contact[tags]" value="newsletter,password page">
    <label class="sr-only" for="PasswordEmail">{{ 'newsletter.label' | t | default: 'Email' }}</label>
    <input
      id="PasswordEmail"
      type="email"
      name="contact[email]"
      class="w-full border border-border bg-bg px-3 py-3 font-body text-body text-ink focus:outline-none focus:border-ink"
      placeholder="{{ 'newsletter.label' | t | default: 'Email' }}"
      required
    >
    {%- assign btn_label = section.settings.button_label | default: 'Notify me' -%}
    {% render 'dc-button', text: btn_label, variant: 'filled', sweep: true, type: 'submit', class: 'w-full' %}
  {% endform %}
</div>

{% schema %}
{
  "name": "Password signup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Leave your email and we will let you know.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" }
  ]
}
{% endschema %}
