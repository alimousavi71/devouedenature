{%- comment -%}
  Product PDP — redesign/Product.dc.html (source of truth).
  Layout, spacing, typography match Product.dc.html exactly.
{%- endcomment -%}

{%- liquid
  assign breadcrumb_collection = collection
  if breadcrumb_collection == blank and product.collections.size > 0
    assign breadcrumb_collection = product.collections.first
  endif

  assign category_label = product.type | default: product.vendor
  if section.settings.category_label != blank
    assign category_label = section.settings.category_label
  elsif category_label == blank or category_label == 'Fragrance' or category_label == 'fragrance'
    assign category_label = 'Skincare'
  endif

  assign breadcrumb_label = ''
  if breadcrumb_collection != blank
    assign breadcrumb_label = breadcrumb_collection.title
  endif
  if section.settings.breadcrumb_label != blank
    assign breadcrumb_label = section.settings.breadcrumb_label
  elsif breadcrumb_label == blank or breadcrumb_label == 'Fragrance' or breadcrumb_label == 'fragrance'
    assign breadcrumb_label = 'Skincare'
  endif

  assign show_refillable = false
  if section.settings.refillable_badge == 'always'
    assign show_refillable = true
  elsif section.settings.refillable_badge == 'auto'
    if product.metafields.custom.refillable.value == true or product.tags contains 'refillable'
      assign show_refillable = true
    endif
  endif

  assign in_stock_message = section.settings.in_stock_message
  assign sold_out_message = section.settings.sold_out_message
  assign add_to_bag_label = section.settings.add_to_bag_label
  assign refillable_label = section.settings.refillable_label
  assign add_to_bag_disabled = false
  if product.selected_or_first_available_variant.available == false
    assign add_to_bag_disabled = true
  endif

  assign accordion_blocks = section.blocks | where: 'type', 'dropdown_information'
-%}

{%- if section.settings.show_breadcrumbs -%}
  <nav
    class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 pt-[22px] flex flex-wrap items-center gap-[10px] font-body text-[10px] tracking-[0.18em] uppercase text-muted"
    aria-label="{{ 'general.breadcrumb' | t | default: 'Breadcrumb' }}"
  >
    {%- if breadcrumb_collection != blank -%}
      <a href="{{ breadcrumb_collection.url }}" class="text-muted hover:text-secondary transition-colors duration-fast ease-fast">{{ breadcrumb_label }}</a>
    {%- else -%}
      <span>{{ breadcrumb_label }}</span>
    {%- endif -%}
    <span aria-hidden="true">/</span>
    <span class="text-ink">{{ product.title }}</span>
  </nav>
  {% render 'dc-seo-breadcrumbs', parent_label: breadcrumb_label, parent_url: breadcrumb_collection.url, current_label: product.title %}
{%- endif -%}

<section
  class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 pt-5 pb-[64px] md:pb-[90px] xl:pb-7"
  data-dc-product-root
>
  <script type="application/json" data-dc-product-json>
    {{ product | json }}
  </script>

  <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_340px] lg:grid-cols-[minmax(0,1fr)_420px] gap-[40px] md:gap-[80px] items-start">
    <div data-dc-product-gallery>
      {% render 'dc-product-gallery', product: product %}
    </div>

    <div class="md:sticky md:top-[120px] self-start pt-2" data-dc-product-buy>
      {%- if category_label != blank -%}
        <p class="font-body text-[10px] tracking-[0.26em] uppercase text-muted m-0" data-dc-product-item>{{ category_label }}</p>
      {%- endif -%}

      <h1 class="font-display font-normal text-h1 text-ink mt-[14px] mb-0" data-dc-product-item>{{ product.title }}</h1>

      <div class="mt-[18px] font-body text-price text-ink leading-none" data-dc-price data-dc-product-item>
        <span data-dc-price-value>{{ product.selected_or_first_available_variant.price | money }}</span>
        {%- if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price -%}
          <span data-dc-compare-price class="text-muted line-through ml-3">{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
        {%- endif -%}
        {%- unless product.has_only_default_variant -%}
          <span data-dc-active-size class="text-muted tracking-[0.14em] text-[11px] uppercase ml-3">{{ product.selected_or_first_available_variant.title }}</span>
        {%- endunless -%}
      </div>

      {%- if product.description != blank -%}
        <div class="dc-product-buy__desc mt-[22px] font-body text-[14px] leading-[1.75] text-secondary max-w-[42ch] text-pretty" data-dc-product-item>
          {{ product.description }}
        </div>
      {%- endif -%}

      {%- unless product.has_only_default_variant -%}
        <div data-dc-product-item>
          {% render 'dc-variant-selector', product: product %}
        </div>
      {%- endunless -%}

      <div class="mt-[28px] flex flex-wrap items-end gap-x-[28px] gap-y-[18px]" data-dc-product-item>
        <div>
          <p class="font-body text-[10px] tracking-[0.22em] uppercase text-muted mb-[12px] m-0">{{ 'products.product.quantity.label' | t | default: 'Quantity' }}</p>
          {% render 'dc-qty-stepper', name: 'quantity', value: 1, id: 'dc-product-qty' %}
        </div>
        <div class="pb-[12px] font-body text-[11px] tracking-[0.1em] text-secondary flex items-center gap-2" data-dc-stock>
          <span class="w-[5px] h-[5px] rounded-pill shrink-0" data-dc-stock-dot style="background:{% if product.selected_or_first_available_variant.available %}#6E7F5B{% else %}#C4B69F{% endif %}"></span>
          <span data-dc-stock-label>
            {%- if product.selected_or_first_available_variant.available -%}
              {{ in_stock_message }}
            {%- else -%}
              {{ sold_out_message }}
            {%- endif -%}
          </span>
        </div>
      </div>

      <form
        data-dc-product-form
        class="mt-[30px]"
        data-dc-product-item
        data-dc-add-label="{{ add_to_bag_label | escape }}"
        data-dc-added-label="{{ section.settings.added_to_bag_label | escape }}"
        data-dc-in-stock="{{ in_stock_message | escape }}"
        data-dc-sold-out="{{ sold_out_message | escape }}"
      >
        <input type="hidden" name="id" data-dc-variant-id value="{{ product.selected_or_first_available_variant.id }}">
        {% render 'dc-button',
          text: add_to_bag_label,
          variant: 'filled',
          sweep: true,
          type: 'submit',
          id: 'dc-add-to-bag',
          disabled: add_to_bag_disabled,
          class: 'w-full h-[58px] text-[11px] tracking-[0.24em]'
        %}
      </form>

      {%- if show_refillable -%}
        <div class="mt-[16px] flex justify-end" data-dc-product-item>
          <span class="font-body text-[10px] tracking-[0.16em] uppercase text-muted">{{ refillable_label }}</span>
        </div>
      {%- endif -%}

      {%- if accordion_blocks.size > 0 -%}
        <div class="dc-product-accordions mt-[40px] border-t border-border" data-dc-product-item>
          {%- for block in accordion_blocks -%}
            {%- liquid
              assign body = ''
              assign media_image = blank
              assign mf_key = block.settings.use_metafield | strip
              assign mf = blank

              if mf_key != blank
                assign mf = product.metafields.custom[mf_key]
              endif

              if mf == blank or mf.value == blank
                if mf_key == 'how_to_apply' or block.settings.heading contains 'How to apply' or block.settings.heading contains 'how to apply'
                  if product.metafields.custom.how_to_apply_image.value != blank
                    assign mf = product.metafields.custom.how_to_apply_image
                  elsif product.metafields.custom.how_to_apply.value != blank
                    assign mf = product.metafields.custom.how_to_apply
                  elsif product.metafields.custom.howto_apply.value != blank
                    assign mf = product.metafields.custom.howto_apply
                  endif
                endif
              endif

              if mf != blank and mf.value != blank
                assign mf_type = mf.type | default: ''
                assign body = mf | metafield_tag
                if mf_type contains 'file_reference' or mf_type contains 'image'
                  assign media_image = true
                endif
              elsif block.settings.description != blank
                assign body = block.settings.description
              endif
            -%}
            {%- if body != blank -%}
              <div {{ block.shopify_attributes }}>
                {%- capture accordion_body -%}
                  {%- if media_image -%}
                    <div class="dc-accordion__media">{{ body }}</div>
                  {%- else -%}
                    {{ body }}
                  {%- endif -%}
                {%- endcapture -%}
                {% render 'dc-product-accordion', heading: block.settings.heading, body: accordion_body %}
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == '@app' -%}
          <div class="mt-6" {{ block.shopify_attributes }}>{% render block %}</div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "DC Product",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Gallery media are uploaded in Shopify Admin → Products → Media (images and videos). Recommended stills: 1400 × 1750 px (4:5). Videos play in the main gallery when selected; thumbnails show a play badge."
    },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    {
      "type": "text",
      "id": "breadcrumb_label",
      "label": "Breadcrumb parent label",
      "default": "Skincare",
      "info": "Shown instead of collection title when set. Use to replace Fragrance."
    },
    {
      "type": "text",
      "id": "category_label",
      "label": "Category label override",
      "info": "Leave blank to use product type or vendor"
    },    {
      "type": "text",
      "id": "in_stock_message",
      "label": "In stock message",
      "default": "In stock — ships within 48 hours"
    },
    {
      "type": "text",
      "id": "sold_out_message",
      "label": "Sold out message",
      "default": "Sold out"
    },
    {
      "type": "text",
      "id": "add_to_bag_label",
      "label": "Add to bag button",
      "default": "Add to the bag"
    },
    {
      "type": "text",
      "id": "added_to_bag_label",
      "label": "Added to bag button",
      "default": "Added to your bag"
    },
    {
      "type": "select",
      "id": "refillable_badge",
      "label": "Refillable badge",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Show when product has tag refillable or metafield" },
        { "value": "always", "label": "Always show" },
        { "value": "never", "label": "Never show" }
      ]
    },
    {
      "type": "text",
      "id": "refillable_label",
      "label": "Refillable badge text",
      "default": "Refillable"
    }
  ],
  "blocks": [
    {
      "type": "dropdown_information",
      "name": "Accordion",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        {
          "type": "select",
          "id": "use_metafield",
          "label": "Product metafield",
          "info": "Content comes from this product’s custom metafield. Description is used only if the metafield is empty.",
          "default": "",
          "options": [
            { "value": "", "label": "None — use description below" },
            { "value": "key_ingredients", "label": "custom.key_ingredients" },
            { "value": "full_ingredients", "label": "custom.full_ingredients" },
            { "value": "signature_details", "label": "custom.signature_details" },
            { "value": "how_to_apply", "label": "custom.how_to_apply (text or image)" },
            { "value": "how_to_apply_image", "label": "custom.how_to_apply_image (image)" },
            { "value": "shipping_returns", "label": "custom.shipping_returns" }
          ]
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Fallback description",
          "info": "Shown only when the metafield is blank. Leave empty for product-only rows."
        },
        {
          "type": "checkbox",
          "id": "characteristics",
          "label": "Use characteristics metafield (legacy)",
          "default": false
        }
      ]
    },
    { "type": "@app" }
  ],
  "presets": [
    {
      "name": "DC Product",
      "blocks": [
        {
          "type": "dropdown_information",
          "settings": { "heading": "Key ingredients", "use_metafield": "key_ingredients" }
        },
        {
          "type": "dropdown_information",
          "settings": { "heading": "Composition", "use_metafield": "full_ingredients" }
        },
        {
          "type": "dropdown_information",
          "settings": { "heading": "Signature details", "use_metafield": "signature_details" }
        },
        {
          "type": "dropdown_information",
          "settings": { "heading": "Shipping & returns", "use_metafield": "shipping_returns" }
        },
        {
          "type": "dropdown_information",
          "settings": { "heading": "How to apply", "use_metafield": "how_to_apply" }
        }
      ]
    }
  ]
}
{% endschema %}
