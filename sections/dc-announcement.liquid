{%- comment -%}
  Editorial "Official launch" announcement strip. Net-new — does not reuse
  sections/countdown.liquid. Styled per redesign/Home.dc.html announcement section.
{%- endcomment -%}
<section
  data-reveal="1"
  class="max-w-page mx-auto px-5 md:px-10 py-10 md:py-[90px] grid grid-cols-[1fr_auto] md:grid-cols-[200px_minmax(0,1fr)_auto] gap-x-4 gap-y-5 md:gap-x-[60px] md:gap-y-0 items-start"
>
  <div class="col-start-1 row-start-1 font-mono text-caption uppercase text-muted">{{ section.settings.date }}</div>

  <div class="col-span-2 md:col-span-1 col-start-1 md:col-start-2 row-start-2 md:row-start-1">
    <h2 class="font-display text-[22px] leading-[1.2] md:text-[32px] md:leading-normal">{{ section.settings.heading }}</h2>
    <p class="mt-3 md:mt-4 font-body text-body-sm md:text-body text-secondary max-w-[52ch]">{{ section.settings.text }}</p>
  </div>

  {%- if section.settings.pill_label != blank -%}
    <div class="col-start-2 row-start-1 md:col-start-3 self-start justify-self-end md:justify-self-auto flex items-center gap-2 px-3 py-2 md:px-4 md:py-3 border border-border font-mono text-caption uppercase text-secondary whitespace-nowrap">
      <span class="w-[5px] h-[5px] rounded-pill bg-gold shrink-0" aria-hidden="true"></span>{{ section.settings.pill_label }}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Announcement",
  "settings": [
    { "type": "text", "id": "date", "label": "Date label", "default": "14 October 2026" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Official launch" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Nuit Vermeille opens in Paris, Milan and Kyoto on the same morning. Refill bars open a week later." },
    { "type": "text", "id": "pill_label", "label": "Pill label", "default": "Three cities" }
  ],
  "presets": [{ "name": "Announcement" }]
}
{% endschema %}
