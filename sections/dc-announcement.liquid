{%- comment -%}
  Launch announcement — redesign/DesignSystem.dc.html foundation band.
  Equal split: label + H2 left · body right. No chip / pill / CTA.
  Tokens: Caption, H2, Body · section rhythm 64 / 90 / 130 · gutter 20 / 24 / 40.
{%- endcomment -%}

{%- liquid
  assign date_label = section.settings.date
  assign heading = section.settings.heading
  assign text = section.settings.text
-%}

{%- if date_label != blank or heading != blank or text != blank -%}
  <section
    class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 py-[64px] md:py-[90px] xl:py-[130px]"
    data-dc-announcement
  >
    <div
      class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-[70px] xl:gap-[100px] items-start border-b border-border pb-[64px] md:pb-[90px]"
      data-reveal-stagger
    >
      <div>
        {%- if date_label != blank -%}
          <p class="font-body text-label uppercase text-muted m-0 tracking-[0.28em]">
            {{ date_label }}
          </p>
        {%- endif -%}

        {%- if heading != blank -%}
          <h2 class="font-display font-normal text-[28px] leading-[1.15] md:text-h2 text-ink mt-[18px] mb-0">
            {{ heading }}
          </h2>
        {%- endif -%}
      </div>

      <div>
        {%- if text != blank -%}
          <p class="font-body text-body text-secondary max-w-[46ch] text-pretty m-0">
            {{ text }}
          </p>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Announcement",
  "tag": "section",
  "class": "dc-section-announcement",
  "settings": [
    {
      "type": "text",
      "id": "date",
      "label": "Date / eyebrow",
      "default": "8 May 2026",
      "info": "DesignSystem Label — 10px uppercase muted"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Official launch",
      "info": "DesignSystem H2 — Syne 40"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Body",
      "default": "Launching in North America and Europe. Get ready to meet your best skin.",
      "info": "DesignSystem Body — Jost 13 / 1.9 · max 46ch"
    }
  ],
  "presets": [
    {
      "name": "Announcement",
      "settings": {
        "date": "8 May 2026",
        "heading": "Official launch",
        "text": "Launching in North America and Europe. Get ready to meet your best skin."
      }
    }
  ]
}
{% endschema %}
