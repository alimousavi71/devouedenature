{%- comment -%}
  New reset-password page (Devoué de Nature redesign). Net-new — does not
  reuse sections/main-reset-password.liquid. Real Shopify
  `reset_customer_password` form. Styled per redesign/AccountAuth.dc.html.
{%- endcomment -%}

<div class="max-w-page mx-auto px-4 md:px-6 py-7 md:py-8">
  <div class="max-w-md mx-auto">
    <h1 class="font-display text-h2 mb-2">{{ 'customer.reset_password.title' | t | default: 'Reset your password' }}</h1>
    <p class="font-body text-body text-secondary mb-6">
      {{ 'customer.reset_password.subtext' | t: email: email | default: 'Enter a new password below.' }}
    </p>

    {%- form 'reset_customer_password' -%}
      <div class="mb-4">
        <label for="dc-password" class="block font-mono text-label uppercase text-muted mb-2">
          {{ 'customer.reset_password.password' | t | default: 'New password' }}
        </label>
        <input
          type="password"
          name="customer[password]"
          id="dc-password"
          autocomplete="new-password"
          {% if form.errors contains 'password' %}aria-invalid="true" aria-describedby="dc-password-error"{% endif %}
          class="w-full border border-border bg-bg px-3 py-3 font-body text-body text-ink focus:outline-none focus:border-ink transition-colors duration-fast ease-fast"
        >
        {%- if form.errors contains 'password' -%}
          <p id="dc-password-error" class="font-body text-body-sm text-error mt-1">
            {{ form.errors.translated_fields['password'] | capitalize }} {{ form.errors.messages['password'] }}
          </p>
        {%- endif -%}
      </div>

      <div class="mb-6">
        <label for="dc-password_confirmation" class="block font-mono text-label uppercase text-muted mb-2">
          {{ 'customer.reset_password.password_confirm' | t | default: 'Repeat password' }}
        </label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="dc-password_confirmation"
          autocomplete="new-password"
          {% if form.errors contains 'password_confirmation' %}aria-invalid="true" aria-describedby="dc-password_confirmation-error"{% endif %}
          class="w-full border border-border bg-bg px-3 py-3 font-body text-body text-ink focus:outline-none focus:border-ink transition-colors duration-fast ease-fast"
        >
        {%- if form.errors contains 'password_confirmation' -%}
          <p id="dc-password_confirmation-error" class="font-body text-body-sm text-error mt-1">
            {{ form.errors.translated_fields['password_confirmation'] | capitalize }} {{ form.errors.messages['password_confirmation'] }}
          </p>
        {%- endif -%}
      </div>

      {%- assign reset_password_submit_label = 'customer.reset_password.submit' | t -%}
      {% render 'dc-button', text: reset_password_submit_label, variant: 'filled', sweep: true, type: 'submit' %}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer reset password",
  "tag": "section",
  "class": "dc-customer-reset-password-section"
}
{% endschema %}
