{%- comment -%}
  Composition band — redesign/Product.dc.html
  Theme editor: all fields. Product admin: custom.composition_*
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow
  if product.metafields.custom.composition_eyebrow != blank
    assign eyebrow = product.metafields.custom.composition_eyebrow.value | default: product.metafields.custom.composition_eyebrow
  endif

  assign heading = section.settings.heading
  if product.metafields.custom.composition_heading != blank
    assign heading = product.metafields.custom.composition_heading.value | default: product.metafields.custom.composition_heading
  endif

  assign use_metafield_body = false
  if product.metafields.custom.composition_body != blank
    assign use_metafield_body = true
  endif

  assign image_1 = section.settings.image_1
  if product.metafields.custom.composition_image_1 != blank
    assign image_1 = product.metafields.custom.composition_image_1.value
  endif

  assign image_2 = section.settings.image_2
  if product.metafields.custom.composition_image_2 != blank
    assign image_2 = product.metafields.custom.composition_image_2.value
  endif
-%}

{%- unless section.settings.hide_section -%}
  <section class="max-w-[1200px] mx-auto px-[20px] md:px-[24px] xl:px-5 py-[64px] md:py-[90px] xl:py-[130px]">
    <header class="text-center" data-reveal-stagger>
      {%- if eyebrow != blank -%}
        <p class="font-body text-[10px] tracking-[0.28em] uppercase text-muted m-0">{{ eyebrow }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="font-display font-normal text-h2 text-ink mt-5 mb-0 mx-auto max-w-[20ch]">{{ heading }}</h2>
      {%- endif -%}
      {%- if use_metafield_body or section.settings.body != blank -%}
        <div class="mt-[22px] mx-auto max-w-[52ch] font-body text-body text-secondary [&_p]:m-0">
          {%- if use_metafield_body -%}
            {{ product.metafields.custom.composition_body | metafield_tag }}
          {%- else -%}
            {{ section.settings.body }}
          {%- endif -%}
        </div>
      {%- endif -%}
    </header>

    <div class="mt-[70px] grid grid-cols-1 md:grid-cols-[1.15fr_0.85fr] gap-[18px] items-end" data-reveal-stagger>
      <div class="relative aspect-[4/5] overflow-hidden bg-[repeating-linear-gradient(135deg,#EFE7DA_0_16px,#F8F3E8_16px_32px)]">
        {%- if image_1 != blank -%}
          {{ image_1 | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'absolute inset-0 w-full h-full object-cover', alt: heading, widths: '500, 800, 1000' }}
        {%- endif -%}
      </div>
      <div class="relative aspect-[3/4] overflow-hidden bg-[repeating-linear-gradient(135deg,#E7E3DB_0_16px,#F4EFE4_16px_32px)]">
        {%- if image_2 != blank -%}
          {{ image_2 | image_url: width: 800 | image_tag: loading: 'lazy', class: 'absolute inset-0 w-full h-full object-cover', alt: heading, widths: '400, 600, 800' }}
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "Product composition",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The composition" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rose at dawn, resin at night" },
    {
      "type": "richtext",
      "id": "body",
      "label": "Description",
      "default": "<p>Three materials, no filler. The formula lists nineteen ingredients where a comparable perfume lists sixty.</p>"
    },
    { "type": "image_picker", "id": "image_1", "label": "Image left (4:5)", "info": "Recommended: 1000 × 1250 px (4:5). Left column. Per-product override: metafield custom.composition_image_1" },
    { "type": "image_picker", "id": "image_2", "label": "Image right (3:4)", "info": "Recommended: 800 × 1067 px (3:4). Right column. Per-product override: metafield custom.composition_image_2" }
  ],
  "presets": [{ "name": "Product composition" }]
}
{% endschema %}
