{%- comment -%}
  About purpose — text + image split with mask reveal + editorial drift
{%- endcomment -%}

{%- unless section.settings.hide_section -%}
  <section class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 pt-[64px] md:pt-[90px] xl:pt-[130px]">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-[70px] xl:gap-[100px] items-start">
      <div>
        <div data-reveal>
          {%- if section.settings.heading != blank -%}
            <h2 class="font-display font-normal text-[32px] md:text-[40px] leading-[1.14] text-ink m-0 max-w-[16ch]">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="mt-[30px] font-body text-[14px] leading-[1.95] text-secondary max-w-[48ch] [&_p]:m-0 [&_p+_p]:mt-[22px]">
              {{ section.settings.body }}
            </div>
          {%- endif -%}
        </div>
      </div>

      <div
        class="relative aspect-[4/5] overflow-hidden bg-[repeating-linear-gradient(135deg,#EFE7DA_0_16px,#F8F3E8_16px_32px)]"
        data-reveal
        data-reveal-mask
        data-dc-editorial-img
      >
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: 'absolute inset-0 w-full h-full object-cover',
              alt: section.settings.heading,
              widths: '600, 900, 1200'
          }}
        {%- else -%}
          <span class="absolute inset-0 flex items-center justify-center font-mono text-[10px] tracking-[0.14em] uppercase text-muted text-center px-4">
            {{ section.settings.placeholder_label | default: 'editorial — botanical, in mist' }}
          </span>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "About purpose",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A Brand with Purpose"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Dévoué de Nature was created to bridge a gap — where luxury meets responsibility, and science meets sensitivity.</p><p>We understand that skin is personal, seasonal, and ever-changing. Our mission is to support skin at every stage with products that feel comforting, refined, and empowering — whether your goal is hydration, rejuvenation, or maintaining healthy, resilient skin. This is skincare designed to evolve with you.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "editorial — botanical, in mist"
    }
  ],
  "presets": [{ "name": "About purpose" }]
}
{% endschema %}
