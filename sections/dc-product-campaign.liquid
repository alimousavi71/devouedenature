{%- comment -%}
  Full-bleed campaign band — redesign/Product.dc.html
  Theme editor: image, eyebrow, heading. Product admin: custom.campaign_*
{%- endcomment -%}

{%- liquid
  assign image = section.settings.image
  if product.metafields.custom.campaign_image != blank
    assign image = product.metafields.custom.campaign_image.value
  endif

  assign eyebrow = section.settings.eyebrow
  if product.metafields.custom.campaign_eyebrow != blank
    assign eyebrow = product.metafields.custom.campaign_eyebrow.value | default: product.metafields.custom.campaign_eyebrow
  endif

  assign heading = section.settings.heading
  if product.metafields.custom.campaign_heading != blank
    assign heading = product.metafields.custom.campaign_heading.value | default: product.metafields.custom.campaign_heading
  endif
  if heading == blank
    assign heading = product.title
  endif
-%}

{%- unless section.settings.hide_section -%}
  <section class="relative h-[78vh] min-h-[560px] flex items-center justify-center overflow-hidden bg-[linear-gradient(155deg,#DBB281,#755F45)]" data-dc-campaign>
    {%- if image != blank -%}
      {{
        image
        | image_url: width: 2560
        | image_tag:
          loading: 'lazy',
          class: 'absolute inset-0 w-full h-full object-cover',
          alt: heading,
          widths: '1200, 1800, 2560',
          sizes: '100vw'
      }}
    {%- endif -%}
    <div class="absolute inset-0 bg-[repeating-linear-gradient(135deg,rgba(255,255,255,0.05)_0_30px,rgba(0,0,0,0.03)_30px_60px)] pointer-events-none" aria-hidden="true"></div>

    <div class="relative z-[1] text-center text-bg px-[20px] md:px-[24px]" data-dc-campaign-inner data-reveal-stagger>
      {%- if eyebrow != blank -%}
        <p class="font-body text-[10px] tracking-[0.3em] uppercase opacity-80 m-0">{{ eyebrow }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <p class="font-display font-normal text-display mt-[22px] mb-0 tracking-[0.01em]">{{ heading }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "Product campaign",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Campaign image",
      "info": "Recommended: 2560 × 1440 px (16:9) or wider. Full-bleed band, min height 560px. Per-product override: metafield custom.campaign_image"
    },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The campaign" },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use product title. Per-product override: custom.campaign_heading"
    }
  ],
  "presets": [{ "name": "Product campaign" }]
}
{% endschema %}
