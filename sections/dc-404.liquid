{%- comment -%}
  404 / not-found page (Devoué de Nature redesign). Net-new — does not reuse
  sections/main-404.liquid. Styled per redesign/Error.dc.html: ONE unified
  dark hero panel containing the numeral/heading/copy/CTAs alongside the
  suggested-product tiles (2-col on desktop), not two separate sections.
  Reuses snippets/dc-product-card.liquid (canonical card).
{%- endcomment -%}

{%- assign suggested = blank -%}
{%- if section.settings.collection != blank -%}
  {%- assign suggested = collections[section.settings.collection].products | slice: 0, 2 -%}
{%- endif -%}

{%- liquid
  assign collection_button_label = section.settings.collection_button_label | default: 'The collection'
  assign search_button_label = section.settings.search_button_label | default: 'Search'
  assign collection_button_url = section.settings.collection_url
  if collection_button_url == blank
    assign collection_button_url = collections['frontpage'].url | default: routes.all_products_collection_url
  endif
  assign product_search_url = routes.search_url | append: '?type=product'
-%}

<div class="bg-ink text-bg px-5 py-16 md:px-[60px] md:py-[130px]" data-reveal="1">
  <div class="max-w-page mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-[70px] items-center">
    <div>
      <p class="font-display text-display leading-none text-gold">404</p>
      <h1 class="font-display text-h2 mt-4">{{ section.settings.heading | default: 'This page has wandered off.' }}</h1>
      {%- if section.settings.text != blank -%}
        <p class="font-body text-body-lg text-bg/70 max-w-[46ch] mt-4">{{ section.settings.text }}</p>
      {%- endif -%}
      <div class="flex flex-wrap items-center gap-3 mt-8">
        {% render 'dc-button', text: collection_button_label, url: collection_button_url, variant: 'outline' %}
        {% render 'dc-button', text: search_button_label, url: product_search_url, variant: 'outline' %}
      </div>
    </div>

    {%- if suggested.size > 0 -%}
      <div class="grid grid-cols-2 gap-4 md:gap-6">
        {%- for card_product in suggested -%}
          {% render 'dc-product-card', card_product: card_product %}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "404",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "This page has wandered off." },
    { "type": "textarea", "id": "text", "label": "Text" },
    { "type": "text", "id": "collection_button_label", "label": "Collection button label", "default": "The collection" },
    { "type": "url", "id": "collection_url", "label": "Collection button link" },
    { "type": "text", "id": "search_button_label", "label": "Search button label", "default": "Search" },
    { "type": "collection", "id": "collection", "label": "Suggested products collection" }
  ]
}
{% endschema %}
