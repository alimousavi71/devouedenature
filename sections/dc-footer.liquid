{%- comment -%}
  Footer — redesign/DesignSystem.dc.html + Home.dc.html.
  Clean 4-column grid, payment icons, compact contact links.
{%- endcomment -%}
{%- liquid
  assign footer_muted = 'rgba(255,250,240,0.7)'
  assign footer_border = 'rgba(255,250,240,0.16)'
  assign footer_input_border = 'rgba(255,250,240,0.35)'

  assign location = section.settings.location | default: 'Toronto'
  assign contact_email = section.settings.contact_email | default: 'info@devouedenature.com'
  assign contact_phone = section.settings.contact_phone | default: '+1 (647) 556-6199'
  assign contact_page = section.settings.contact_page | default: '/pages/contact'
  assign phone_href = contact_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', ''
  assign instagram_url = section.settings.instagram_url | default: settings.social_instagram_link | default: 'https://www.instagram.com/devoueskin/'

  assign brand_banner_heading = section.settings.brand_banner_heading | default: 'Dévoué de Nature'
  assign brand_banner_heading = brand_banner_heading | replace: 'Devoue', 'Dévoué' | replace: 'DEVOUE', 'DÉVOUÉ'
  assign brand_banner_tagline = section.settings.brand_banner_tagline | default: 'Redefining skincare — with purpose, with you.'

  assign footer_brand_name = settings.seo_business_name | default: shop.name | default: 'Dévoué de Nature'
  assign footer_brand_name = footer_brand_name | replace: 'Devoue', 'Dévoué' | replace: 'DEVOUE', 'DÉVOUÉ'
-%}

<footer class="bg-ink text-[#EFE7DA] overflow-visible">
  {%- unless section.settings.hide_brand_banner -%}
    <div class="dc-brand-banner text-center px-[16px] md:px-[24px] py-[32px] md:py-[48px] xl:py-[56px] border-b" style="border-color: {{ footer_border }};" data-dc-brand-banner data-reveal>
      {%- if brand_banner_heading != blank -%}
        <p class="dc-brand-banner__title font-display font-normal text-[22px] md:text-[28px] xl:text-[32px] leading-[1.1] tracking-[0.01em] text-gold m-0">
          {{ brand_banner_heading }}
        </p>
      {%- endif -%}
      {%- if brand_banner_tagline != blank -%}
        <p class="dc-brand-banner__tagline mt-[8px] md:mt-[10px] mx-auto max-w-[40ch] font-body text-[12px] md:text-[13px] leading-[1.6] md:leading-[1.7] text-bg/75 m-0">
          {{ brand_banner_tagline }}
        </p>
      {%- endif -%}
    </div>
  {%- endunless -%}

  <div class="max-w-page mx-auto px-5 md:px-10 pt-12 md:pt-16 lg:pt-[70px] pb-4 md:pb-5 overflow-visible">
    <div
      class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-[1.15fr_repeat(3,minmax(0,1fr))] gap-x-6 gap-y-10 md:gap-x-8 lg:gap-x-12 pb-10 md:pb-12 border-b"
      style="border-color: {{ footer_border }};"
    >
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'brand' -%}
            <div class="col-span-2 md:col-span-4 lg:col-span-1 min-w-0" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                <a href="{{ routes.root_url }}" class="inline-block opacity-90 hover:opacity-100 transition-opacity duration-normal ease-normal">
                  {{
                    block.settings.logo
                    | image_url: width: 300
                    | image_tag:
                      loading: 'lazy',
                      class: 'h-auto w-[120px] max-w-full',
                      alt: footer_brand_name,
                      widths: '120, 240'
                  }}
                </a>
              {%- else -%}
                <a href="{{ routes.root_url }}" class="font-display text-[22px] leading-[1.2] text-[#EFE7DA] no-underline hover:opacity-80 transition-opacity duration-normal ease-normal">
                  {{ footer_brand_name }}
                </a>
              {%- endif -%}

              {%- if block.settings.text != blank -%}
                <div class="mt-4 font-body text-[13px] leading-[1.75] max-w-[40ch] m-0 opacity-[0.82]">
                  {{ block.settings.text }}
                </div>
              {%- endif -%}

              {%- if block.settings.show_newsletter -%}
                {%- liquid
                  assign nl_placeholder = block.settings.newsletter_placeholder | default: 'Email address'
                  assign nl_send_label = block.settings.newsletter_button_label | default: 'Send'
                  assign nl_form_id = 'DcFooterNewsletter-' | append: block.id
                -%}
                <div class="mt-6 max-w-[380px]">
                  {%- if block.settings.newsletter_heading != blank -%}
                    <p class="font-body text-[10px] tracking-[0.24em] uppercase m-0" style="color: {{ footer_muted }};">
                      {{ block.settings.newsletter_heading }}
                    </p>
                  {%- endif -%}

                  {%- form 'customer', id: nl_form_id, class: 'mt-3' -%}
                    <input type="hidden" name="contact[tags]" value="newsletter">
                    <div class="flex items-stretch border-b" style="border-color: {{ footer_input_border }};">
                      <label class="sr-only" for="{{ nl_form_id }}-email">{{ 'newsletter.label' | t | default: 'Email' }}</label>
                      <input
                        id="{{ nl_form_id }}-email"
                        type="email"
                        name="contact[email]"
                        value="{{ form.email }}"
                        placeholder="{{ nl_placeholder }}"
                        class="flex-1 min-w-0 h-[46px] border-0 bg-transparent font-body text-[13px] tracking-[0.06em] outline-none placeholder:text-[#EFE7DA] placeholder:opacity-50"
                        style="color: #EFE7DA;"
                        autocorrect="off"
                        autocapitalize="off"
                        autocomplete="email"
                        required
                      >
                      <button
                        type="submit"
                        class="shrink-0 border-0 bg-transparent font-body text-[10px] tracking-[0.22em] uppercase cursor-pointer px-1 hover:opacity-60 transition-opacity duration-normal ease-normal"
                        style="color: #EFE7DA;"
                      >
                        {{ nl_send_label }}
                      </button>
                    </div>

                    {%- if form.posted_successfully? -%}
                      <p class="mt-3 font-body text-[10px] tracking-[0.18em] uppercase opacity-70 m-0" role="status">
                        {{ 'newsletter.success' | t | default: 'Thank you for subscribing.' }}
                      </p>
                    {%- elsif form.errors -%}
                      <p class="mt-3 font-body text-[10px] tracking-[0.18em] uppercase text-error m-0" role="alert">
                        {{ form.errors.messages['email'] | default: 'Please enter a valid email.' }}
                      </p>
                    {%- endif -%}
                  {%- endform -%}
                </div>
              {%- endif -%}
            </div>

          {%- when 'contact' -%}
            {%- liquid
              assign contact_heading = block.settings.heading | default: 'Contact Us'
              assign contact_address = block.settings.address
              assign contact_email = block.settings.email | default: section.settings.contact_email | default: 'info@devouedenature.com'
              assign contact_phone = block.settings.phone | default: section.settings.contact_phone | default: '+1 (647) 556-6199'
              assign phone_href = contact_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' | replace: '‑', ''
            -%}
            <div class="col-span-2 md:col-span-2 lg:col-span-1 min-w-0" {{ block.shopify_attributes }}>
              {%- if contact_heading != blank -%}
                <p class="font-body text-[10px] tracking-[0.24em] uppercase m-0" style="color: {{ footer_muted }};">
                  {{ contact_heading }}
                </p>
              {%- endif -%}

              <div class="mt-4 flex flex-col gap-[14px] font-body text-[12px] leading-[1.75] tracking-[0.06em] opacity-[0.82]">
                {%- if contact_address != blank -%}
                  <div>
                    <p class="m-0">Address:</p>
                    <p class="m-0 mt-1">{{ contact_address | newline_to_br }}</p>
                  </div>
                {%- endif -%}
                {%- if contact_phone != blank -%}
                  <p class="m-0">
                    Tel :
                    <a href="tel:{{ phone_href }}" class="dc-footer-link inline">{{ contact_phone }}</a>
                  </p>
                {%- endif -%}
                {%- if contact_email != blank -%}
                  <p class="m-0">
                    Email:
                    <a href="mailto:{{ contact_email }}" class="dc-footer-link inline">{{ contact_email }}</a>
                  </p>
                {%- endif -%}
              </div>
            </div>

          {%- when 'subscribe' -%}
            {%- liquid
              assign eyebrow = block.settings.eyebrow | default: 'Correspondence'
              assign nl_heading = block.settings.heading | default: 'Four letters a year, no more'
              assign placeholder = block.settings.placeholder | default: 'Email address'
              assign send_label = block.settings.button_label | default: 'Send'
            -%}
            <div class="col-span-2 md:col-span-4 lg:col-span-1 min-w-0" {{ block.shopify_attributes }}>
              {%- if block.settings.logo != blank -%}
                <a href="{{ routes.root_url }}" class="inline-block mb-4 opacity-90 hover:opacity-100 transition-opacity duration-normal ease-normal">
                  {{
                    block.settings.logo
                    | image_url: width: 300
                    | image_tag:
                      loading: 'lazy',
                      class: 'h-auto w-[120px] max-w-full',
                      alt: footer_brand_name,
                      widths: '120, 240'
                  }}
                </a>
              {%- endif -%}

              <p class="font-body text-[10px] tracking-[0.24em] uppercase m-0" style="color: {{ footer_muted }};">
                {{ eyebrow }}
              </p>
              <p class="mt-3 font-display text-[22px] md:text-[24px] leading-[1.35] text-[#EFE7DA] max-w-[22ch] m-0">
                {{ nl_heading }}
              </p>

              {%- if block.settings.description != blank -%}
                <p class="mt-3 font-body text-[13px] leading-[1.75] max-w-[40ch] m-0 opacity-[0.82]">
                  {{ block.settings.description }}
                </p>
              {%- endif -%}

              {%- form 'customer', id: 'DcFooterNewsletter', class: 'mt-5 max-w-[380px]' -%}
                <input type="hidden" name="contact[tags]" value="newsletter">
                <div class="flex items-stretch border-b" style="border-color: {{ footer_input_border }};">
                  <label class="sr-only" for="DcFooterNewsletter-email">{{ 'newsletter.label' | t | default: 'Email' }}</label>
                  <input
                    id="DcFooterNewsletter-email"
                    type="email"
                    name="contact[email]"
                    value="{{ form.email }}"
                    placeholder="{{ placeholder }}"
                    class="flex-1 min-w-0 h-[46px] border-0 bg-transparent font-body text-[13px] tracking-[0.06em] outline-none placeholder:text-[#EFE7DA] placeholder:opacity-50"
                    style="color: #EFE7DA;"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    required
                  >
                  <button
                    type="submit"
                    class="shrink-0 border-0 bg-transparent font-body text-[10px] tracking-[0.22em] uppercase cursor-pointer px-1 hover:opacity-60 transition-opacity duration-normal ease-normal"
                    style="color: #EFE7DA;"
                  >
                    {{ send_label }}
                  </button>
                </div>

                {%- if form.posted_successfully? -%}
                  <p class="mt-3 font-body text-[10px] tracking-[0.18em] uppercase opacity-70 m-0" role="status">
                    {{ 'newsletter.success' | t | default: 'Thank you for subscribing.' }}
                  </p>
                {%- elsif form.errors -%}
                  <p class="mt-3 font-body text-[10px] tracking-[0.18em] uppercase text-error m-0" role="alert">
                    {{ form.errors.messages['email'] | default: 'Please enter a valid email.' }}
                  </p>
                {%- endif -%}
              {%- endform -%}
            </div>

          {%- when 'link_list' -%}
            {%- liquid
              assign col_heading = block.settings.heading
              assign footer_menu = linklists[block.settings.menu]
              if col_heading == blank and footer_menu.links.size > 0
                assign col_heading = footer_menu.title
              endif

              assign link_1_label = block.settings.link_1_label
              assign link_1_url = block.settings.link_1_url
              assign link_2_label = block.settings.link_2_label
              assign link_2_url = block.settings.link_2_url
              assign link_3_label = block.settings.link_3_label
              assign link_3_url = block.settings.link_3_url
              assign link_4_label = block.settings.link_4_label
              assign link_4_url = block.settings.link_4_url
              assign link_5_label = block.settings.link_5_label
              assign link_5_url = block.settings.link_5_url

              assign has_custom_links = false
              if link_1_label != blank or link_2_label != blank or link_3_label != blank or link_4_label != blank or link_5_label != blank
                assign has_custom_links = true
              endif
            -%}
            <div class="min-w-0" {{ block.shopify_attributes }}>
              {%- if col_heading != blank -%}
                <p class="font-body text-[10px] tracking-[0.24em] uppercase m-0" style="color: {{ footer_muted }};">
                  {{ col_heading }}
                </p>
              {%- endif -%}

              <ul class="mt-4 flex flex-col gap-2.5 list-none p-0 m-0">
                {%- if footer_menu.links.size > 0 -%}
                  {%- for link in footer_menu.links limit: 5 -%}
                    <li>
                      <a href="{{ link.url }}" class="dc-footer-link">{{ link.title }}</a>
                    </li>
                  {%- endfor -%}
                {%- elsif has_custom_links -%}
                  {%- if link_1_label != blank -%}
                    <li>
                      <a
                        href="{{ link_1_url | default: '#' }}"
                        class="dc-footer-link"
                        {% if link_1_url contains 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}
                      >{{ link_1_label }}</a>
                    </li>
                  {%- endif -%}
                  {%- if link_2_label != blank -%}
                    <li>
                      <a
                        href="{{ link_2_url | default: '#' }}"
                        class="dc-footer-link"
                        {% if link_2_url contains 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}
                      >{{ link_2_label }}</a>
                    </li>
                  {%- endif -%}
                  {%- if link_3_label != blank -%}
                    <li>
                      <a
                        href="{{ link_3_url | default: '#' }}"
                        class="dc-footer-link"
                        {% if link_3_url contains 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}
                      >{{ link_3_label }}</a>
                    </li>
                  {%- endif -%}
                  {%- if link_4_label != blank -%}
                    <li>
                      <a
                        href="{{ link_4_url | default: '#' }}"
                        class="dc-footer-link"
                        {% if link_4_url contains 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}
                      >{{ link_4_label }}</a>
                    </li>
                  {%- endif -%}
                  {%- if link_5_label != blank -%}
                    <li>
                      <a
                        href="{{ link_5_url | default: '#' }}"
                        class="dc-footer-link"
                        {% if link_5_url contains 'http' %}target="_blank" rel="noopener noreferrer"{% endif %}
                      >{{ link_5_label }}</a>
                    </li>
                  {%- endif -%}
                {%- elsif block.settings.use_social_fallback -%}
                  {%- if instagram_url != blank -%}
                    <li><a href="{{ instagram_url }}" class="dc-footer-link" target="_blank" rel="noopener noreferrer">Instagram</a></li>
                  {%- endif -%}
                  {%- if settings.social_facebook_link != blank -%}
                    <li><a href="{{ settings.social_facebook_link }}" class="dc-footer-link" target="_blank" rel="noopener noreferrer">Facebook</a></li>
                  {%- endif -%}
                  {%- if settings.social_tiktok_link != blank -%}
                    <li><a href="{{ settings.social_tiktok_link }}" class="dc-footer-link" target="_blank" rel="noopener noreferrer">TikTok</a></li>
                  {%- endif -%}
                {%- endif -%}

                {%- if block.settings.append_contact -%}
                  <li><a href="{{ contact_page }}" class="dc-footer-link">Contact</a></li>
                  <li><a href="mailto:{{ contact_email }}" class="dc-footer-link">{{ contact_email }}</a></li>
                  <li><a href="tel:{{ phone_href }}" class="dc-footer-link">{{ contact_phone }}</a></li>
                {%- endif -%}
              </ul>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="dc-footer-bar pt-4 md:pt-5 flex flex-col items-start gap-y-4 md:flex-row md:flex-wrap md:items-center md:gap-x-4 md:gap-y-3 md:justify-between font-body text-[10px] tracking-[0.18em] uppercase overflow-visible relative z-[2]">
        <div class="dc-footer-bar__meta-row flex flex-col items-start gap-y-2 w-full min-w-0 md:w-auto md:flex-row md:flex-wrap md:items-center md:gap-x-5 md:gap-y-2">
          <span class="dc-footer-bar__meta">{{ footer_brand_name }} — {{ location }}</span>

          {%- if section.settings.enable_country_selector -%}
            {%- if localization.available_countries.size > 1 -%}
              {% render 'dc-localization-form', id: 'FooterCountry', label: section.settings.currency_label, default: 'Currency' %}
            {%- else -%}
              <span class="dc-footer-bar__meta">
                {{ localization.country.currency.iso_code }}
                {{ localization.country.currency.symbol }}
              </span>
            {%- endif -%}
          {%- endif -%}
        </div>

        {%- if section.settings.payment_enable and shop.enabled_payment_types.size > 0 -%}
          <ul class="hidden md:flex flex-wrap items-center gap-1 list-none p-0 m-0 md:mx-auto" role="list" aria-label="{{ section.settings.payment_label | default: 'We accept' }}">
            {%- for type in shop.enabled_payment_types -%}
              <li class="dc-footer-payment__item">
                {{ type | payment_type_svg_tag: class: 'dc-footer-payment__icon' }}
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="dc-footer-bar__legal flex flex-col items-start gap-y-3 w-full min-w-0 md:w-auto md:flex-row md:flex-wrap md:items-center md:gap-x-4 md:gap-y-2 md:justify-end">
          {%- if instagram_url != blank -%}
            <a
              href="{{ instagram_url }}"
              class="dc-footer-instagram"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              title="Instagram"
            >
              <span class="dc-footer-instagram__icon" aria-hidden="true">{% render 'icon-instagram' %}</span>
              <span class="dc-footer-instagram__label">Instagram</span>
            </a>
          {%- endif -%}

          {%- if section.settings.show_policy -%}
            <span class="dc-footer-bar__policies flex flex-wrap items-center gap-y-1 opacity-60">
              {%- assign policy_index = 0 -%}
              {%- for policy in shop.policies -%}
                {%- if policy != blank and policy.body != blank -%}
                  {%- if policy_index > 0 -%}<span class="px-2" aria-hidden="true">·</span>{%- endif -%}
                  <a href="{{ policy.url }}" class="hover:opacity-100 transition-opacity duration-normal ease-normal">{{ policy.title }}</a>
                  {%- assign policy_index = policy_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
              {%- if policy_index == 0 -%}
                {%- assign legal_fallback = section.settings.legal_fallback | default: 'Legal · Privacy · Cookies' -%}
                {%- assign legal_parts = legal_fallback | split: '·' -%}
                {%- for part in legal_parts -%}
                  {%- assign part = part | strip -%}
                  {%- if part != blank -%}
                    {%- unless forloop.first -%}<span class="px-2" aria-hidden="true">·</span>{%- endunless -%}
                    <span>{{ part }}</span>
                  {%- endif -%}
                {%- endfor -%}
              {%- endif -%}
            </span>
          {%- else -%}
            <span class="opacity-60">{{ section.settings.legal_fallback | default: 'Legal · Privacy · Cookies' }}</span>
          {%- endif -%}
        </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer",
  "settings": [
    {
      "type": "header",
      "content": "Brand banner"
    },
    {
      "type": "checkbox",
      "id": "hide_brand_banner",
      "label": "Hide brand banner",
      "default": false
    },
    {
      "type": "text",
      "id": "brand_banner_heading",
      "label": "Banner heading",
      "default": "Dévoué de Nature"
    },
    {
      "type": "text",
      "id": "brand_banner_tagline",
      "label": "Banner tagline",
      "default": "Redefining skincare — with purpose, with you."
    },
    {
      "type": "text",
      "id": "location",
      "label": "Location",
      "default": "Toronto"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL",
      "info": "Shown as an icon at the bottom of the footer. Falls back to Theme settings → Social media."
    },
    {
      "type": "header",
      "content": "Contact links (Client care column)"
    },
    {
      "type": "url",
      "id": "contact_page",
      "label": "Contact page"
    },
    {
      "type": "text",
      "id": "contact_email",
      "label": "Email",
      "default": "info@devouedenature.com"
    },
    {
      "type": "text",
      "id": "contact_phone",
      "label": "Phone",
      "default": "+1 (647) 556-6199"
    },
    {
      "type": "header",
      "content": "Country / currency"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "label": "Show country and currency selector",
      "default": true
    },
    {
      "type": "text",
      "id": "currency_label",
      "label": "Currency label",
      "default": "Currency"
    },
    {
      "type": "header",
      "content": "Payment icons"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "payment_label",
      "label": "Payment label",
      "default": "We accept"
    },
    {
      "type": "header",
      "content": "Legal bar"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "label": "Show shop policy links",
      "default": true
    },
    {
      "type": "text",
      "id": "legal_fallback",
      "label": "Legal fallback text",
      "default": "Legal · Privacy · Cookies"
    }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text below logo",
          "default": "<p>Redefining skincare — with purpose, with you.</p>"
        },
        {
          "type": "header",
          "content": "Newsletter"
        },
        {
          "type": "checkbox",
          "id": "show_newsletter",
          "label": "Show newsletter signup",
          "default": true
        },
        {
          "type": "text",
          "id": "newsletter_heading",
          "label": "Newsletter heading",
          "default": "Correspondence"
        },
        {
          "type": "text",
          "id": "newsletter_placeholder",
          "label": "Email placeholder",
          "default": "Email address"
        },
        {
          "type": "text",
          "id": "newsletter_button_label",
          "label": "Submit label",
          "default": "Send"
        }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Contact Us"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address",
          "default": "150 King Street West, Suite 215, Toronto, ON M5H 1J9"
        },
        {
          "type": "text",
          "id": "phone",
          "label": "Phone",
          "default": "+1 (647) 556-6199"
        },
        {
          "type": "text",
          "id": "email",
