{%- comment -%}
  Homepage hero — redesign/Home.dc.html + original media-slideshow video.
  Heading is light (bg) over media; CTA uses inverse surface button.
{%- endcomment -%}
{%- liquid
  assign use_video = false
  if section.settings.show_video
    if section.settings.video != blank or section.settings.video_url != blank
      assign use_video = true
    endif
  endif

  assign autoplay = section.settings.autoplay_video
  assign loop = section.settings.loop_video
  assign muted = section.settings.muted_video
  assign playsinline = true
-%}

<section
  class="relative min-h-screen h-screen flex items-end overflow-hidden bg-gradient-to-br from-[#E3DCCE] via-gold to-secondary"
  data-dc-hero
>
  {%- if use_video -%}
    <div class="absolute inset-0 h-full w-full overflow-hidden" data-dc-hero-media>
      {%- if section.settings.video != blank -%}
        {{
          section.settings.video
          | video_tag:
            image_size: '1920x',
            autoplay: autoplay,
            loop: loop,
            muted: muted,
            playsinline: playsinline,
            controls: false,
            class: 'dc-hero__video'
        }}
      {%- elsif section.settings.video_url != blank -%}
        {%- if section.settings.video_url.type == 'youtube' -%}
          <iframe
            src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?enablejsapi=1&autoplay={% if autoplay %}1{% else %}0{% endif %}{% if muted %}&mute=1{% endif %}&controls=0{% if loop %}&playlist={{ section.settings.video_url.id }}&loop=1{% endif %}&rel=0"
            class="dc-hero__video dc-hero__embed pointer-events-none"
            allow="autoplay; encrypted-media"
            allowfullscreen
            title="{{ section.settings.heading | escape }}"
          ></iframe>
        {%- elsif section.settings.video_url.type == 'vimeo' -%}
          <iframe
            src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay={% if autoplay %}1&autopause=0{% else %}0{% endif %}{% if muted %}&muted=1{% endif %}&controls=false{% if loop %}&loop=true{% endif %}"
            class="dc-hero__video dc-hero__embed pointer-events-none"
            allow="autoplay; encrypted-media"
            allowfullscreen
            title="{{ section.settings.heading | escape }}"
          ></iframe>
        {%- endif -%}
      {%- endif -%}
    </div>
  {%- elsif section.settings.image != blank -%}
    <div class="absolute inset-0 h-full w-full overflow-hidden" data-dc-hero-media data-parallax="30">
      {{
        section.settings.image
        | image_url: width: 1800
        | image_tag:
          loading: 'eager',
          class: 'dc-hero__video',
          alt: section.settings.heading,
          widths: '900, 1200, 1800',
          sizes: '100vw'
      }}
    </div>
  {%- endif -%}

  <div class="relative z-[1] w-full max-w-page mx-auto px-5 md:px-10 pb-10 md:pb-[70px]">
    {%- if section.settings.heading != blank -%}
      <h1
        class="font-display font-normal text-h2 md:text-page-title leading-[1.1] max-w-[16ch] text-bg"
        data-dc-hero-title
        style="letter-spacing: {{ section.settings.letter_spacing | divided_by: 1000.0 }}em"
      >
        {{ section.settings.heading }}
      </h1>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <div class="mt-[34px]" data-dc-hero-cta>
        {% render 'dc-button', text: section.settings.button_label, url: section.settings.button_url, variant: 'inverse', class: 'h-[54px] px-10' %}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "checkbox",
      "id": "show_video",
      "label": "Show video",
      "default": true
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video file",
      "info": "Uploaded to Shopify Files. Takes priority over the fallback image."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Optional YouTube or Vimeo URL if no file is uploaded."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Poster / fallback image",
      "info": "Shown when video is off, or as the video poster frame."
    },
    {
      "type": "checkbox",
      "id": "autoplay_video",
      "label": "Autoplay video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "muted_video",
      "label": "Mute video",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop_video",
      "label": "Loop video",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Gold in the glass, not on the label"
    },
    {
      "type": "range",
      "id": "letter_spacing",
      "label": "Letter spacing",
      "min": -50,
      "max": 300,
      "step": 5,
      "unit": "x",
      "default": 5
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button link"
    }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
