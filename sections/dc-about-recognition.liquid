{%- comment -%}
  About recognition — Swiper gallery (left) + text (right)
{%- endcomment -%}

{%- liquid
  assign slide_count = 0
  for i in (1..6)
    assign image_key = 'image_' | append: i
    assign slide_image = section.settings[image_key]
    if slide_image != blank
      assign slide_count = slide_count | plus: 1
    endif
  endfor
-%}

{%- unless section.settings.hide_section -%}
  <section
    class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 pt-[48px] md:pt-[90px] xl:pt-[120px]"
    data-dc-recognition-carousel
    data-autoplay="{{ section.settings.autoplay }}"
    data-delay="{{ section.settings.autoplay_delay | default: 5000 }}"
    data-loop="{{ section.settings.loop }}"
    data-effect="{{ section.settings.transition_effect | default: 'fade' }}"
  >
    <div class="grid grid-cols-1 md:grid-cols-2 gap-[28px] md:gap-[70px] xl:gap-[100px] items-start">
      <div class="order-2 md:order-1 min-w-0 self-start">
        <div
          class="relative aspect-[4/3] overflow-hidden bg-[repeating-linear-gradient(135deg,#EFE7DA_0_16px,#F8F3E8_16px_32px)]"
          data-reveal
          data-reveal-mask
        >
          {%- if slide_count > 0 -%}
            <div class="swiper dc-recognition-swiper absolute inset-0 h-full w-full">
              <div class="swiper-wrapper">
                {%- for i in (1..6) -%}
                  {%- liquid
                    assign image_key = 'image_' | append: i
                    assign slide_image = section.settings[image_key]
                    assign alt_key = 'image_' | append: i | append: '_alt'
                    assign slide_alt = section.settings[alt_key]
                  -%}
                  {%- if slide_image != blank -%}
                    <div class="swiper-slide relative h-full">
                      {{
                        slide_image
                        | image_url: width: 1400
                        | image_tag:
                          loading: 'lazy',
                          class: 'absolute inset-0 w-full h-full object-cover',
                          alt: slide_alt | default: section.settings.heading,
                          widths: '700, 1000, 1400'
                      }}
                    </div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- else -%}
            <span class="absolute inset-0 flex items-center justify-center font-mono text-[10px] tracking-[0.14em] uppercase text-muted text-center px-4">
              {{ section.settings.placeholder_label | default: 'recognition — award and press' }}
            </span>
          {%- endif -%}
        </div>
      </div>

      <div class="order-1 md:order-2 min-w-0 self-start">
        <div class="border-t border-ink pt-[26px]" data-reveal>
          {%- if section.settings.heading != blank -%}
            <h2 class="font-display font-normal text-[26px] md:text-[40px] leading-[1.14] text-ink m-0 max-w-[16ch]">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="mt-[30px] font-body text-[14px] leading-[1.95] text-secondary max-w-[48ch] [&_p]:m-0 [&_p+_p]:mt-[22px]">
              {{ section.settings.body }}
            </div>
          {%- endif -%}
          {%- if section.settings.show_pagination and slide_count > 1 -%}
            <div
              class="dc-recognition-pagination swiper-pagination mt-10 flex gap-[10px] items-center !relative !w-auto"
              data-dc-recognition-pagination
              aria-label="Gallery navigation"
            ></div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "About recognition",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recognition & Excellence"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Our dedication to thoughtful design and innovation has been recognized internationally, including the A' Design Award, reflecting our commitment to excellence not only in formulation, but in the entire sensory and aesthetic experience.</p><p>From Toronto to Los Angeles, our presence on city billboards marks our growing global footprint, bringing our vision of elevated skincare to a wider audience.</p>"
    },
    { "type": "header", "content": "Gallery images" },
    {
      "type": "paragraph",
      "content": "Upload up to 6 images. Each filled slot becomes one slide in the carousel (left side)."
    },
    { "type": "image_picker", "id": "image_1", "label": "Gallery image 1" },
    { "type": "text", "id": "image_1_alt", "label": "Gallery image 1 — alt text" },
    { "type": "image_picker", "id": "image_2", "label": "Gallery image 2" },
    { "type": "text", "id": "image_2_alt", "label": "Gallery image 2 — alt text" },
    { "type": "image_picker", "id": "image_3", "label": "Gallery image 3" },
    { "type": "text", "id": "image_3_alt", "label": "Gallery image 3 — alt text" },
    { "type": "image_picker", "id": "image_4", "label": "Gallery image 4" },
    { "type": "text", "id": "image_4_alt", "label": "Gallery image 4 — alt text" },
    { "type": "image_picker", "id": "image_5", "label": "Gallery image 5" },
    { "type": "text", "id": "image_5_alt", "label": "Gallery image 5 — alt text" },
    { "type": "image_picker", "id": "image_6", "label": "Gallery image 6" },
    { "type": "text", "id": "image_6_alt", "label": "Gallery image 6 — alt text" },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "recognition — award and press",
      "info": "Shown when no gallery images are uploaded."
    },
    { "type": "header", "content": "Carousel" },
    {
      "type": "checkbox",
      "id": "show_pagination",
      "label": "Show gallery dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay slides",
      "default": true
    },
    {
      "type": "range",
      "id": "autoplay_delay",
      "label": "Autoplay delay",
      "min": 3000,
      "max": 9000,
      "step": 500,
      "default": 5000,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop slides",
      "default": true
    },
    {
      "type": "select",
      "id": "transition_effect",
      "label": "Transition",
      "default": "fade",
      "options": [
        { "value": "fade", "label": "Fade" },
        { "value": "slide", "label": "Slide" }
      ]
    }
  ],
  "presets": [{ "name": "About recognition" }]
}
{% endschema %}
