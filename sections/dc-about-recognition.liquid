{%- comment -%}
  About recognition — image + text split (image left) with mask + editorial drift
{%- endcomment -%}

{%- unless section.settings.hide_section -%}
  <section class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 pt-[64px] md:pt-[90px] xl:pt-[120px]">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-[70px] xl:gap-[100px] items-start">
      <div class="order-2 md:order-1">
        <div
          class="relative aspect-[4/3] overflow-hidden bg-[repeating-linear-gradient(135deg,#EFE7DA_0_16px,#F8F3E8_16px_32px)]"
          data-reveal
          data-reveal-mask
          data-dc-editorial-img
        >
          {%- if section.settings.image != blank -%}
            {{
              section.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                class: 'absolute inset-0 w-full h-full object-cover',
                alt: section.settings.heading,
                widths: '700, 1000, 1400'
            }}
          {%- else -%}
            <span class="absolute inset-0 flex items-center justify-center font-mono text-[10px] tracking-[0.14em] uppercase text-muted text-center px-4">
              {{ section.settings.placeholder_label | default: 'recognition — award and press' }}
            </span>
          {%- endif -%}
        </div>
      </div>

      <div class="order-1 md:order-2">
        <div class="border-t border-ink pt-[26px]" data-reveal data-reveal-float>
          {%- if section.settings.heading != blank -%}
            <h2 class="font-display font-normal text-[32px] md:text-[40px] leading-[1.14] text-ink m-0 max-w-[16ch]">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}
          {%- if section.settings.body != blank -%}
            <div class="mt-[30px] font-body text-[14px] leading-[1.95] text-secondary max-w-[48ch] [&_p]:m-0 [&_p+_p]:mt-[22px]">
              {{ section.settings.body }}
            </div>
          {%- endif -%}
          {%- if section.settings.show_pagination_dots -%}
            <div class="mt-10 flex gap-[10px] items-center" aria-hidden="true">
              <span class="w-[22px] h-[6px] rounded-pill bg-ink"></span>
              <span class="w-[6px] h-[6px] rounded-pill bg-border"></span>
              <span class="w-[6px] h-[6px] rounded-pill bg-border"></span>
              <span class="w-[6px] h-[6px] rounded-pill bg-border"></span>
              <span class="w-[6px] h-[6px] rounded-pill bg-border"></span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "About recognition",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recognition & Excellence"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Our dedication to thoughtful design and innovation has been recognized internationally, including the A' Design Award, reflecting our commitment to excellence not only in formulation but in the entire sensory and aesthetic experience.</p><p>From Toronto to Los Angeles, our presence continues to grow — bringing our vision of devoted skincare to a wider audience.</p>"
    },
    { "type": "image_picker", "id": "image", "label": "Image" },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "recognition — award and press"
    },
    {
      "type": "checkbox",
      "id": "show_pagination_dots",
      "label": "Show decorative dots",
      "default": true
    }
  ],
  "presets": [{ "name": "About recognition" }]
}
{% endschema %}
