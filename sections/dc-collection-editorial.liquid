{%- comment -%}
  Collection editorial band — redesign/Collection.dc.html journal section.
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'Journal'
  assign heading = section.settings.heading | default: 'Crafted with intention'
  assign body = section.settings.body | default: 'Every Dévoué de Nature formula is developed with physicians and scientists, then filled with precision in Canada. We choose ingredients for performance and tolerance — so each step of your ritual feels considered, never aggressive.'
  assign link_label = section.settings.link_label | default: 'Our story'
  assign image_placeholder = section.settings.image_placeholder | default: 'editorial — formulation lab'
-%}

{%- unless section.settings.hide_section -%}
  <section class="mt-[64px] md:mt-[90px] xl:mt-[130px] bg-elevated py-[64px] md:py-[90px] xl:py-[120px] px-5 md:px-10" data-reveal>
    <div class="max-w-[1200px] mx-auto grid grid-cols-1 md:grid-cols-2 gap-10 md:gap-[90px] items-center">
      <div class="relative aspect-[4/5] overflow-hidden">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover', widths: '500, 750, 1000' }}
        {%- else -%}
          <div class="w-full h-full bg-[repeating-linear-gradient(135deg,#E3DCCE_0_18px,#F2ECE1_18px_36px)] flex items-center justify-center">
            <span class="font-mono text-[11px] tracking-[0.16em] uppercase text-muted text-center px-4">{{ image_placeholder }}</span>
          </div>
        {%- endif -%}
      </div>

      <div>
        {%- if eyebrow != blank -%}
          <p class="font-body text-[10px] tracking-[0.28em] uppercase text-muted m-0">{{ eyebrow }}</p>
        {%- endif -%}
        {%- if heading != blank -%}
          <h2 class="font-display font-normal text-[38px] leading-[1.2] text-ink mt-5 mb-0 max-w-[22ch]">{{ heading }}</h2>
        {%- endif -%}
        {%- if body != blank -%}
          <p class="font-body text-[13px] leading-[1.95] text-secondary max-w-[44ch] mt-6 mb-0 text-pretty">{{ body }}</p>
        {%- endif -%}
        {%- if link_label != blank and section.settings.link_url != blank -%}
          <a
            href="{{ section.settings.link_url }}"
            class="inline-block mt-[30px] font-body text-[10px] tracking-[0.22em] uppercase text-ink border-b border-ink pb-1 hover:text-secondary transition-colors duration-fast ease-fast"
          >
            {{ link_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "Collection editorial",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended 1000 × 1250 px (4:5)." },
    { "type": "text", "id": "image_placeholder", "label": "Image placeholder label", "default": "editorial — formulation lab" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Crafted with intention" },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "Every Dévoué de Nature formula is developed with physicians and scientists, then filled with precision in Canada. We choose ingredients for performance and tolerance — so each step of your ritual feels considered, never aggressive."
    },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "Our story" },
    { "type": "url", "id": "link_url", "label": "Link" }
  ],
  "presets": [{ "name": "Collection editorial" }]
}
{% endschema %}
