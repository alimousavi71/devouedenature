{%- comment -%}
  Homepage brand values — replaces launch announcement band.
{%- endcomment -%}

{% render 'dc-brand-values-band', section: section %}

{% schema %}
{
  "name": "Brand values",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtfully made in Canada"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Proudly developed and made in Canada, our formulas bring together thoughtful ingredient selection, scientific expertise, and rigorous attention to quality. Every detail is considered with purpose, creating skincare designed to deliver both a sensorial experience and meaningful results."
    },
    {
      "type": "checkbox",
      "id": "show_intro_maple_leaf",
      "label": "Show maple leaf after intro",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (SVG or image)" },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Custom SVG markup",
          "info": "Optional. Overrides uploaded icon."
        },
        {
          "type": "select",
          "id": "mark",
          "label": "Preset icon (fallback)",
          "default": "circle",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "square", "label": "Square" },
            { "value": "maple_leaf", "label": "Maple leaf" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Made in Canada" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Formulated and filled with precision in Canada."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "mark": "maple_leaf",
            "title": "Made in Canada",
            "text": "Formulated and filled with precision in Canada."
          }
        },
        {
          "type": "value",
          "settings": {
            "mark": "diamond",
            "title": "Physician formulated",
            "text": "Developed by a collective of physicians and scientists."
          }
        },
        {
          "type": "value",
          "settings": {
            "mark": "square",
            "title": "Clinically tested",
            "text": "Assessed for safety, tolerance, and performance."
          }
        },
        {
          "type": "value",
          "settings": {
            "mark": "circle",
            "title": "Cruelty-free",
            "text": "No animal testing at any stage, in any market."
          }
        }
      ]
    }
  ]
}
{% endschema %}
