{%- comment -%}
  Homepage brand values — replaces launch announcement band.
{%- endcomment -%}

{%- unless section.settings.hide_section -%}
  <section class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 py-[64px] md:py-[90px] xl:py-[130px]">
    {%- if section.settings.heading != blank -%}
      <h2 class="font-display font-normal text-[28px] md:text-[40px] leading-[1.15] text-ink m-0 text-center" data-reveal>
        {{ section.settings.heading }}
      </h2>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div
        class="mt-[46px] md:mt-[70px] grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[30px] py-[40px] md:py-[50px] border-y border-border"
        data-reveal-stagger
      >
        {%- for block in section.blocks -%}
          <div class="text-center px-[10px]" data-dc-lift-hover {{ block.shopify_attributes }}>
            {% render 'dc-claim-mark',
              icon: block.settings.icon,
              icon_svg: block.settings.icon_svg,
              mark: block.settings.mark
            %}
            {%- if block.settings.title != blank -%}
              <p class="mt-6 font-body text-[11px] tracking-[0.2em] uppercase text-ink m-0">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="mt-3 mx-auto font-body text-[12px] leading-[1.8] text-secondary max-w-[26ch] m-0">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "Brand values",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtfully made in Canada"
    }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "limit": 4,
      "settings": [
        { "type": "image_picker", "id": "icon", "label": "Icon (SVG or image)" },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Custom SVG markup",
          "info": "Optional. Overrides uploaded icon."
        },
        {
          "type": "select",
          "id": "mark",
          "label": "Preset icon (fallback)",
          "default": "circle",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "square", "label": "Square" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Made in Canada" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Formulated and filled with precision in Canada."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Brand values",
      "blocks": [
        {
          "type": "value",
          "settings": {
            "mark": "circle",
            "title": "Made in Canada",
            "text": "Formulated and filled with precision in Canada."
          }
        },
        {
          "type": "value",
          "settings": {
            "mark": "diamond",
            "title": "Physician formulated",
            "text": "Developed by a collective of physicians and scientists."
          }
        },
        {
          "type": "value",
          "settings": {
            "mark": "square",
            "title": "Clinically tested",
            "text": "Assessed for safety, tolerance, and performance."
          }
        },
        {
          "type": "value",
          "settings": {
            "mark": "circle",
            "title": "Cruelty-free",
            "text": "No animal testing at any stage, in any market."
          }
        }
      ]
    }
  ]
}
{% endschema %}
