{%- comment -%}
  Dark care CTA — redesign/Home.dc.html "We are here for you" block.
  Optional background image; falls back to ink when empty.
{%- endcomment -%}
{%- liquid
  assign heading = section.settings.heading
  if heading == blank
    assign heading = 'We are here for you'
  endif

  assign body_html = section.settings.text
  if body_html == blank
    assign body_html = '<p>Five people answer the client address, in French or English, within one working day.</p>'
  endif

  assign button_label = section.settings.button_label
  if button_label == blank
    assign button_label = 'Write to us'
  endif

  assign button_url = section.settings.button_url
  if button_url == blank
    assign button_url = 'https://wa.link/sgbrwa'
  endif

  assign bg_image = section.settings.background_image
-%}

<section data-reveal="1" class="max-w-page mx-auto px-5 md:px-10 pb-12 md:pb-[120px]">
  <div class="relative overflow-hidden bg-ink px-[20px] py-5 md:px-[60px] md:py-[90px] grid grid-cols-1 md:grid-cols-[1fr_auto] gap-5 md:gap-[60px] items-start md:items-center">
    {%- if bg_image != blank -%}
      <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
        {{
          bg_image
          | image_url: width: 2400
          | image_tag:
            loading: 'lazy',
            class: 'absolute inset-0 w-full h-full object-cover',
            alt: '',
            widths: '800, 1400, 2400',
            sizes: '100vw'
        }}
        <div class="absolute inset-0 bg-ink/55"></div>
      </div>
    {%- endif -%}

    <div class="relative z-[1]">
      <h2 class="font-display font-normal text-[26px] md:text-[36px] leading-[1.1] text-bg m-0">
        {{ heading }}
      </h2>
      <div class="mt-3 md:mt-[16px] font-body text-[13px] leading-[1.7] md:text-body md:leading-[1.9] text-gold max-w-[46ch] [&_p]:m-0">
        {{ body_html }}
      </div>
    </div>

    <a
      href="{{ button_url }}"
      class="relative z-[1] inline-flex items-center justify-center w-full md:w-auto h-[48px] md:h-[54px] px-4 md:px-10 border border-gold bg-transparent text-bg font-body text-[11px] tracking-[0.24em] uppercase whitespace-nowrap transition-colors duration-normal ease-normal hover:bg-gold hover:text-ink shrink-0"
    >
      {{ button_label }}
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Care banner",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image",
      "info": "Optional. When empty, the solid ink background is used."
    },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We are here for you" },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Five people answer the client address, in French or English, within one working day.</p>"
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Write to us" },
    { "type": "url", "id": "button_url", "label": "Button link" }
  ],
  "presets": [{ "name": "Care banner" }]
}
{% endschema %}
