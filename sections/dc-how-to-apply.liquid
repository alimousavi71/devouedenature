{%- comment -%}
  Product ritual — Theme Editor only. Same for every product page.
  Not connected to product metafields (step_1…5 unused).
{%- endcomment -%}

{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign ritual_card_count = 0
  for block in step_blocks
    if block.settings.product != blank
      assign ritual_card_count = ritual_card_count | plus: 1
    elsif block.settings.image != blank and block.settings.title != blank
      assign ritual_card_count = ritual_card_count | plus: 1
    endif
  endfor
-%}

{%- unless section.settings.hide_section -%}
  <section class="bg-elevated py-[48px] md:py-[90px] xl:py-7 px-[16px] md:px-[24px] xl:px-5">
    <div class="max-w-page mx-auto">
      <header class="text-center max-w-[62ch] mx-auto" data-reveal-stagger>
        {%- if section.settings.heading != blank -%}
          <h2 class="font-display font-normal text-[24px] md:text-[38px] leading-none tracking-[0.02em] uppercase text-ink m-0">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="mt-[14px] md:mt-[22px] font-body text-[14px] md:text-body leading-[1.65] md:leading-[1.7] text-secondary [&_p]:m-0">{{ section.settings.description }}</div>
        {%- endif -%}
      </header>

      {%- if ritual_card_count > 0 -%}
        <ol class="mt-[32px] md:mt-[70px] grid grid-cols-2 lg:grid-cols-5 gap-[20px] md:gap-[40px] items-start list-none p-0 m-0" data-reveal-stagger>
          {%- assign shown_steps = 0 -%}
          {%- for block in step_blocks -%}
            {%- liquid
              assign step_product = block.settings.product
              assign step_image = block.settings.image
              assign step_title = block.settings.title
              assign step_url = block.settings.link_url
              assign link_label = block.settings.link_label | default: section.settings.step_link_label
              assign show_card = false

              if step_product != blank
                assign show_card = true
                if step_title == blank
                  assign step_title = step_product.title
                endif
                if step_image == blank and step_product.featured_image != blank
                  assign step_image = step_product.featured_image
                endif
                if step_url == blank
                  assign step_url = step_product.url
                endif
              elsif step_image != blank and step_title != blank
                assign show_card = true
              endif
            -%}
            {%- if show_card -%}
              {%- assign shown_steps = shown_steps | plus: 1 -%}
              <li class="min-w-0 text-center relative" {{ block.shopify_attributes }}>
                <p class="font-body text-[12px] md:text-[13px] tracking-[0.1em] text-secondary m-0">{{ shown_steps }}.</p>
                <div class="dc-ritual-card__media mt-[14px] md:mt-[22px] relative aspect-[800/1023] bg-ink overflow-hidden">
                  {%- if step_image != blank -%}
                    {{
                      step_image
                      | image_url: width: 800
                      | image_tag:
                        loading: 'lazy',
                        class: 'dc-ritual-card__img absolute inset-0 w-full h-full object-cover',
                        alt: step_title,
                        widths: '400, 600, 800'
                    }}
                  {%- elsif step_product != blank -%}
                    <span class="absolute inset-0 flex items-center justify-center font-mono text-[9px] tracking-[0.14em] uppercase text-gold">{{ step_product.title | truncate: 18 }}</span>
                  {%- endif -%}
                  {%- if shown_steps < ritual_card_count -%}
                    <span class="hidden lg:block absolute top-1/2 -right-5 translate-x-1/2 -translate-y-1/2 text-[16px] leading-none text-secondary pointer-events-none z-[2]" aria-hidden="true">+</span>
                  {%- endif -%}
                </div>
                {%- if step_title != blank -%}
                  <p class="mt-[14px] md:mt-[26px] font-body text-[10px] md:text-[12px] tracking-[0.12em] md:tracking-[0.14em] uppercase leading-[1.5] md:leading-[1.6] min-h-[3.2em] text-ink m-0">{{ step_title }}</p>
                {%- endif -%}
                {%- if step_url != blank and link_label != blank -%}
                  <a href="{{ step_url }}" class="inline-block mt-[8px] md:mt-[10px] font-body text-[9px] md:text-[10px] tracking-[0.18em] md:tracking-[0.2em] uppercase text-secondary border-b border-[#C4B69F] pb-[3px] hover:text-ink hover:border-ink transition-colors duration-normal ease-normal">
                    {{ link_label }}
                  </a>
                {%- endif -%}
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "Product ritual",
  "tag": "section",
  "class": "dc-how-to-apply",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shared on all product pages. Edit once in Theme Editor — not linked to product metafields."
    },
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your skincare ritual"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Discover the power of a complete ritual — crafted to cleanse, treat, and illuminate for maximum efficacy.</p>"
    },
    {
      "type": "text",
      "id": "step_link_label",
      "label": "Step link label",
      "default": "View product"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Ritual step",
      "limit": 5,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Same products for every product page. Leave empty to hide this card."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Name override",
          "info": "Optional. Defaults to the product title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override",
          "info": "Optional. Defaults to the product featured image. Recommended: 800 × 800 px."
        },
        { "type": "url", "id": "link_url", "label": "Custom link URL", "info": "Optional. Defaults to the product URL." },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "View product" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product ritual",
      "blocks": [
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" },
        { "type": "step" }
      ]
    }
  ]
}
{% endschema %}
