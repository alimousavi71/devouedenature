{%- comment -%}
  About integrity / quality pillars — 4-up row
{%- endcomment -%}

{%- unless section.settings.hide_section -%}
  <section class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 pt-[48px] md:pt-[90px] xl:pt-[130px]">
    <header class="text-center" data-reveal-stagger>
      {%- if section.settings.heading != blank -%}
        <h2 class="font-display font-normal text-[26px] md:text-[42px] text-ink m-0">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.intro != blank -%}
        <p class="mt-[18px] md:mt-[22px] mx-auto max-w-[52ch] font-body text-[14px] leading-[1.8] md:leading-[1.9] text-secondary m-0">{{ section.settings.intro }}</p>
      {%- endif -%}
    </header>

    {%- if section.blocks.size > 0 -%}
      <div
        class="mt-[34px] md:mt-[70px] grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-[24px] md:gap-[30px] py-[28px] md:py-[50px] border-y border-border"
        data-reveal-stagger
      >
        {%- for block in section.blocks -%}
          <div class="text-center px-[10px]" data-dc-lift-hover {{ block.shopify_attributes }}>
            {% render 'dc-claim-mark',
              icon: block.settings.icon,
              icon_svg: block.settings.icon_svg,
              mark: block.settings.mark
            %}
            {%- if block.settings.title != blank -%}
              <p class="mt-4 font-body text-[11px] tracking-[0.2em] uppercase text-ink m-0">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="mt-3 mx-auto font-body text-[12px] leading-[1.8] text-secondary max-w-[26ch] m-0">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.closing != blank -%}
      <p class="mt-[40px] md:mt-[50px] mx-auto max-w-[74ch] text-center font-body text-[14px] leading-[1.9] text-secondary m-0" data-reveal>
        {{ section.settings.closing }}
      </p>
    {%- endif -%}
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "About integrity",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Commitment to Quality & Integrity"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "We are devoted to the care in skincare you can trust by prioritizing:"
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "Closing",
      "default": "Transparency matters to us. We believe you deserve to know not only what is in your skincare, but why it was chosen. Our products are proudly made in Canada under strict quality and safety standards."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "limit": 8,
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon (SVG or image)"
        },
        {
          "type": "html",
          "id": "icon_svg",
          "label": "Custom SVG markup",
          "info": "Optional. Overrides uploaded icon. Paste inline SVG."
        },
        {
          "type": "select",
          "id": "mark",
          "label": "Preset icon (fallback)",
          "default": "diamond",
          "options": [
            { "value": "diamond", "label": "Diamond" },
            { "value": "circle", "label": "Circle" },
            { "value": "square", "label": "Square" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Clinically tested" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every formula assessed under dermatological supervision."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About integrity",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "mark": "diamond",
            "title": "Clinically tested",
            "text": "Every formula assessed under dermatological supervision."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "mark": "circle",
            "title": "Cruelty-free",
            "text": "No animal testing at any stage, in any market."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "mark": "diamond",
            "title": "Thoughtfully sourced",
            "text": "Traceable botanicals, named suppliers, disclosed origins."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "mark": "circle",
            "title": "Sustainable packaging",
            "text": "Glass, aluminium and refills wherever the formula allows."
          }
        }
      ]
    }
  ]
}
{% endschema %}
