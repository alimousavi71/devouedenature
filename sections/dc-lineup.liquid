{%- comment -%}
  "The Vermeille lineup" + claims — single section per redesign/Home.dc.html lines 71–93.
{%- endcomment -%}
<section data-reveal="1" class="max-w-page mx-auto px-5 md:px-10 pt-[110px]">
  {%- if section.settings.heading != blank -%}
    <h2 class="font-display font-normal text-[34px] leading-none text-ink m-0">
      {{ section.settings.heading }}
    </h2>
  {%- endif -%}

  {%- liquid
    assign lineup_products = section.settings.product_list
    if lineup_products == blank and section.settings.collection != blank
      assign lineup_collection = collections[section.settings.collection]
      assign lineup_products = lineup_collection.products
    endif
  -%}

  <div class="mt-[46px] grid grid-cols-2 md:grid-cols-5 gap-[20px]" data-reveal-stagger>
    {%- for card_product in lineup_products limit: section.settings.products_to_show -%}
      {% render 'dc-lineup-card', card_product: card_product %}
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 0 -%}
    {% render 'dc-claims-row', blocks: section.blocks, embedded: true %}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Lineup",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Vermeille lineup" },
    {
      "type": "product_list",
      "id": "product_list",
      "label": "Products",
      "limit": 10
    },
    { "type": "collection", "id": "collection", "label": "Collection (fallback if no products picked)" },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 10, "step": 1, "default": 5 }
  ],
  "blocks": [
    {
      "type": "claim",
      "name": "Claim",
      "settings": [
        {
          "type": "select",
          "id": "mark",
          "label": "Mark",
          "default": "circle",
          "options": [
            { "value": "circle", "label": "Circle" },
            { "value": "diamond", "label": "Diamond" },
            { "value": "square", "label": "Square" }
          ]
        },
        { "type": "text", "id": "label", "label": "Label" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Lineup",
      "blocks": [
        { "type": "claim", "settings": { "mark": "circle", "label": "Grasse distillation" } },
        { "type": "claim", "settings": { "mark": "diamond", "label": "Nineteen ingredients" } },
        { "type": "claim", "settings": { "mark": "square", "label": "Refillable in glass" } },
        { "type": "claim", "settings": { "mark": "circle", "label": "Filled by hand" } },
        { "type": "claim", "settings": { "mark": "diamond", "label": "Numbered collar" } }
      ]
    }
  ]
}
{% endschema %}
