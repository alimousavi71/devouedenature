{%- comment -%}
  Collection hero — redesign/Collection.dc.html breadcrumb + title.
  Intro / description column removed per product request.
{%- endcomment -%}

{%- liquid
  assign breadcrumb_parent = section.settings.breadcrumb_parent | default: 'Home'
  assign breadcrumb_parent_key = breadcrumb_parent | strip | downcase
  if breadcrumb_parent == blank or breadcrumb_parent_key == 'fragrance' or breadcrumb_parent_key == 'skincare'
    assign breadcrumb_parent = 'Home'
  endif

  assign breadcrumb_parent_url = section.settings.breadcrumb_parent_url
  if breadcrumb_parent_url == blank
    assign breadcrumb_parent_url = routes.root_url
  endif

  assign eyebrow = section.settings.eyebrow | default: 'The collection'
-%}

{%- unless section.settings.hide_section -%}
  {%- if section.settings.show_breadcrumb -%}
    <nav
      class="max-w-page mx-auto px-[16px] md:px-10 pt-[22px] font-body text-[10px] tracking-[0.18em] uppercase text-muted"
      aria-label="{{ 'general.breadcrumbs.home' | t | default: 'Breadcrumb' }}"
    >
      <ol class="flex flex-wrap items-center gap-[10px] list-none m-0 p-0">
        <li>
          <a href="{{ breadcrumb_parent_url }}" class="text-muted hover:text-ink transition-colors duration-fast ease-fast">
            {{ breadcrumb_parent }}
          </a>
        </li>
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">{{ collection.title }}</li>
      </ol>
    </nav>
    {% render 'dc-seo-breadcrumbs', parent_label: breadcrumb_parent, parent_url: breadcrumb_parent_url, current_label: collection.title %}
  {%- endif -%}

  <section class="max-w-page mx-auto px-[16px] md:px-10 pt-[28px] md:pt-[70px]" data-reveal>
    {%- if eyebrow != blank -%}
      <p class="font-body text-[9px] md:text-[10px] tracking-[0.24em] md:tracking-[0.28em] uppercase text-muted m-0">{{ eyebrow }}</p>
    {%- endif -%}
    <h1 class="font-display font-normal text-[28px] md:text-[54px] leading-[1.08] text-ink mt-[10px] md:mt-[18px] mb-0 text-balance">{{ collection.title }}</h1>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    { "type": "header", "content": "Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_parent", "label": "Breadcrumb parent", "default": "Home", "info": "Defaults to Home. “Skincare” / “Fragrance” are remapped to Home." },
    { "type": "url", "id": "breadcrumb_parent_url", "label": "Breadcrumb parent link", "info": "Defaults to the homepage when empty." },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" }
  ],
  "presets": [{ "name": "Collection banner" }]
}
{% endschema %}
