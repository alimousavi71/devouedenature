{%- comment -%}
  Collection hero — redesign/Collection.dc.html breadcrumb + title.
  Intro / description column removed per product request.
{%- endcomment -%}

{%- liquid
  assign breadcrumb_parent = section.settings.breadcrumb_parent | default: 'Fragrance'
  assign eyebrow = section.settings.eyebrow | default: 'The collection'
-%}

{%- unless section.settings.hide_section -%}
  {%- if section.settings.show_breadcrumb -%}
    <nav
      class="max-w-page mx-auto px-5 md:px-10 pt-[22px] font-body text-[10px] tracking-[0.18em] uppercase text-muted"
      aria-label="{{ 'general.breadcrumbs.home' | t | default: 'Breadcrumb' }}"
    >
      <ol class="flex flex-wrap items-center gap-[10px] list-none m-0 p-0">
        {%- if section.settings.breadcrumb_parent_url != blank -%}
          <li>
            <a href="{{ section.settings.breadcrumb_parent_url }}" class="text-muted hover:text-ink transition-colors duration-fast ease-fast">
              {{ breadcrumb_parent }}
            </a>
          </li>
        {%- else -%}
          <li class="text-muted">{{ breadcrumb_parent }}</li>
        {%- endif -%}
        <li aria-hidden="true">/</li>
        <li class="text-ink" aria-current="page">{{ collection.title }}</li>
      </ol>
    </nav>
  {%- endif -%}

  <section class="max-w-page mx-auto px-5 md:px-10 pt-[70px]" data-reveal>
    {%- if eyebrow != blank -%}
      <p class="font-body text-[10px] tracking-[0.28em] uppercase text-muted m-0">{{ eyebrow }}</p>
    {%- endif -%}
    <h1 class="font-display font-normal text-[54px] leading-[1.08] text-ink mt-[18px] mb-0">{{ collection.title }}</h1>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "Collection banner",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    { "type": "header", "content": "Breadcrumb" },
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Show breadcrumb", "default": true },
    { "type": "text", "id": "breadcrumb_parent", "label": "Breadcrumb parent", "default": "Fragrance" },
    { "type": "url", "id": "breadcrumb_parent_url", "label": "Breadcrumb parent link" },
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The collection" }
  ],
  "presets": [{ "name": "Collection banner" }]
}
{% endschema %}
