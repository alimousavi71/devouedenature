{%- comment -%}
  Product recommendations — redesign/Product.dc.html "Discover"
  Sources: Shopify auto recommendations | collection | manual product blocks
{%- endcomment -%}

{%- liquid
  assign product_blocks = section.blocks | where: 'type', 'product'
  assign manual_count = product_blocks.size
-%}

{%- unless section.settings.hide_section -%}
  {%- if section.settings.source == 'collection' and section.settings.collection != blank -%}
    {%- assign rec_products = section.settings.collection.products -%}
    {%- assign rec_limit = section.settings.products_to_show -%}

    {%- if rec_products.size > 0 -%}
      <section class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 py-[64px] md:py-[90px] xl:py-[130px]">
        <header class="text-center mb-[66px]" data-reveal-stagger>
          {%- if section.settings.eyebrow != blank -%}
            <p class="font-body text-[10px] tracking-[0.28em] uppercase text-muted m-0">{{ section.settings.eyebrow }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2 class="font-display font-normal text-[38px] leading-none text-ink mt-5 mb-0">{{ section.settings.heading }}</h2>
          {%- endif -%}
        </header>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[40px]" data-reveal-stagger>
          {%- for rec_product in rec_products limit: rec_limit -%}
            {% render 'dc-product-discover-card', card_product: rec_product %}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

  {%- elsif section.settings.source == 'manual' and manual_count > 0 -%}
    <section class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 py-[64px] md:py-[90px] xl:py-[130px]">
      <header class="text-center mb-[66px]" data-reveal-stagger>
        {%- if section.settings.eyebrow != blank -%}
          <p class="font-body text-[10px] tracking-[0.28em] uppercase text-muted m-0">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="font-display font-normal text-[38px] leading-none text-ink mt-5 mb-0">{{ section.settings.heading }}</h2>
        {%- endif -%}
      </header>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[40px]" data-reveal-stagger>
        {%- for block in product_blocks -%}
          {%- if block.settings.product != blank -%}
            <div {{ block.shopify_attributes }}>
              {% render 'dc-product-discover-card', card_product: block.settings.product %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </section>

  {%- else -%}
    <product-recommendations
      class="block"
      data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ section.settings.products_to_show }}"
    >
      {%- if recommendations.performed and recommendations.products_count > 0 -%}
        <section class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 py-[64px] md:py-[90px] xl:py-[130px]">
          <header class="text-center mb-[66px]" data-reveal-stagger>
            {%- if section.settings.eyebrow != blank -%}
              <p class="font-body text-[10px] tracking-[0.28em] uppercase text-muted m-0">{{ section.settings.eyebrow }}</p>
            {%- endif -%}
            {%- if section.settings.heading != blank -%}
              <h2 class="font-display font-normal text-[38px] leading-none text-ink mt-5 mb-0">{{ section.settings.heading }}</h2>
            {%- endif -%}
          </header>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[40px]" data-reveal-stagger>
            {%- for rec_product in recommendations.products limit: section.settings.products_to_show -%}
              {% render 'dc-product-discover-card', card_product: rec_product %}
            {%- endfor -%}
          </div>
        </section>
      {%- elsif section.settings.collection != blank -%}
        {%- assign fallback_products = section.settings.collection.products -%}
        {%- if fallback_products.size > 0 -%}
          <section class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 py-[64px] md:py-[90px] xl:py-[130px]">
            <header class="text-center mb-[66px]" data-reveal-stagger>
              {%- if section.settings.eyebrow != blank -%}
                <p class="font-body text-[10px] tracking-[0.28em] uppercase text-muted m-0">{{ section.settings.eyebrow }}</p>
              {%- endif -%}
              {%- if section.settings.heading != blank -%}
                <h2 class="font-display font-normal text-[38px] leading-none text-ink mt-5 mb-0">{{ section.settings.heading }}</h2>
              {%- endif -%}
            </header>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-[40px]" data-reveal-stagger>
              {%- for rec_product in fallback_products limit: section.settings.products_to_show -%}
                {% render 'dc-product-discover-card', card_product: rec_product %}
              {%- endfor -%}
            </div>
          </section>
        {%- endif -%}
      {%- endif -%}
    </product-recommendations>
  {%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Product recommendations",
  "settings": [
    {
      "type": "paragraph",
      "content": "Recommended product card image (featured media): 900 × 1200 px (3:4). Set on each product in Admin → Products → Media."
    },
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Continue" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Discover" },
    {
      "type": "select",
      "id": "source",
      "label": "Product source",
      "default": "auto",
      "options": [
        { "value": "auto", "label": "Shopify recommendations (with collection fallback)" },
        { "value": "collection", "label": "Collection only" },
        { "value": "manual", "label": "Manual product blocks" }
      ]
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Used when source is Collection, or as fallback when Shopify recommendations are empty"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "limit": 4,
      "settings": [
        { "type": "product", "id": "product", "label": "Product" }
      ]
    }
  ],
  "presets": [{ "name": "Product recommendations" }]
}
{% endschema %}
