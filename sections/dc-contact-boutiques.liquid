{%- comment -%}
  Contact boutiques band — redesign/Contact.dc.html #E7E3DB three-column grid.
{%- endcomment -%}

{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'Boutiques'
  assign heading = section.settings.heading | default: 'Three addresses'
  assign link_label_default = section.settings.link_label | default: 'Book an appointment'
-%}

{%- unless section.settings.hide_section -%}
  <section class="bg-elevated py-[48px] md:py-[90px] xl:py-[110px] px-[16px] md:px-10" data-reveal>
    <div class="max-w-page mx-auto">
      {%- if eyebrow != blank -%}
        <p class="font-body text-[9px] md:text-[10px] tracking-[0.24em] md:tracking-[0.28em] uppercase text-muted m-0">{{ eyebrow }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h2 class="font-display font-normal text-[24px] md:text-[38px] leading-none text-ink mt-[12px] md:mt-5 mb-0">{{ heading }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="mt-[28px] md:mt-[60px] grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-[28px] md:gap-10">
          {%- for block in section.blocks -%}
            {%- liquid
              assign city = block.settings.city
              assign address = block.settings.address
              assign hours = block.settings.hours
              assign slot_label = block.settings.image_slot_label | default: 'boutique — interior'
              assign link_label = block.settings.link_label | default: link_label_default
            -%}
            <article {{ block.shopify_attributes }}>
              {%- if block.settings.image != blank -%}
                <div class="relative aspect-[4/3] overflow-hidden">
                  {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'lazy', class: 'w-full h-full object-cover', widths: '350, 525, 700' }}
                </div>
              {%- else -%}
                <div class="relative aspect-[4/3] bg-[repeating-linear-gradient(135deg,#E3DCCE_0_16px,#F2ECE1_16px_32px)] flex items-center justify-center">
                  <span class="font-mono text-[10px] tracking-[0.14em] uppercase text-muted text-center px-4">{{ slot_label }}</span>
                </div>
              {%- endif -%}

              {%- if city != blank -%}
                <h3 class="font-display text-[20px] md:text-[22px] text-ink mt-[16px] md:mt-[22px] mb-0">{{ city }}</h3>
              {%- endif -%}
              {%- if address != blank -%}
                <p class="font-body text-[12px] leading-[1.7] md:leading-[1.85] text-secondary mt-[8px] md:mt-[10px] mb-0">{{ address }}</p>
              {%- endif -%}
              {%- if hours != blank -%}
                <p class="font-body text-[12px] leading-[1.7] md:leading-[1.85] text-muted mt-[6px] md:mt-2 mb-0">{{ hours }}</p>
              {%- endif -%}
              {%- if block.settings.link_url != blank and link_label != blank -%}
                <a
                  href="{{ block.settings.link_url }}"
                  class="inline-block mt-[14px] md:mt-5 font-body text-[10px] tracking-[0.22em] uppercase text-ink border-b border-ink pb-1 hover:text-secondary transition-colors duration-fast ease-fast"
                >
                  {{ link_label }}
                </a>
              {%- endif -%}
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "Contact boutiques",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Boutiques" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Three addresses" },
    { "type": "text", "id": "link_label", "label": "Default appointment link label", "default": "Book an appointment" }
  ],
  "blocks": [
    {
      "type": "boutique",
      "name": "Boutique",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Recommended 700 × 525 px (4:3)." },
        { "type": "text", "id": "image_slot_label", "label": "Image placeholder label", "default": "boutique — interior" },
        { "type": "text", "id": "city", "label": "City", "default": "Paris" },
        { "type": "text", "id": "address", "label": "Address", "default": "14 rue de Sévigné, 75004" },
        { "type": "text", "id": "hours", "label": "Hours", "default": "Tue — Sat, 11h — 19h" },
        { "type": "text", "id": "link_label", "label": "Link label" },
        { "type": "url", "id": "link_url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact boutiques",
      "blocks": [
        {
          "type": "boutique",
          "settings": {
            "city": "Paris",
            "address": "14 rue de Sévigné, 75004",
            "hours": "Tue — Sat, 11h — 19h",
            "image_slot_label": "boutique — interior"
          }
        },
        {
          "type": "boutique",
          "settings": {
            "city": "Milan",
            "address": "Via Gesù 6, 20121",
            "hours": "Mon — Sat, 10h — 19h",
            "image_slot_label": "boutique — vitrine"
          }
        },
        {
          "type": "boutique",
          "settings": {
            "city": "Kyoto",
            "address": "284 Nakanocho, Nakagyo-ku",
            "hours": "Wed — Sun, 12h — 18h",
            "image_slot_label": "boutique — counter"
          }
        }
      ]
    }
  ]
}
{% endschema %}
