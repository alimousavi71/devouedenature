{%- comment -%}
  About hero — redesign/About.dc.html
  Uses canonical data-dc-hero entrance (word-split title, media scale, staggered copy).
{%- endcomment -%}
{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'About'
  assign heading = section.settings.heading | default: shop.name
  assign tagline = section.settings.tagline
-%}

{%- unless section.settings.hide_section -%}
  <section
    class="relative h-[480px] md:h-[560px] xl:h-[640px] flex items-end overflow-hidden {% if section.settings.image == blank %}bg-[linear-gradient(165deg,#30271D_0%,#5B4933_52%,#DBB281_100%)]{% else %}bg-ink{% endif %}"
    data-dc-hero
    data-dc-about-hero
  >
    {%- if section.settings.image != blank -%}
      <div class="dc-about-hero__media absolute inset-0 h-full w-full overflow-hidden" data-dc-hero-media>
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            class: 'absolute inset-0 w-full h-full object-cover object-center',
            alt: heading,
            widths: '900, 1400, 1800, 2400',
            sizes: '100vw'
        }}
      </div>
      <div class="absolute inset-0 bg-[linear-gradient(180deg,rgba(48,39,29,0.25)_0%,rgba(48,39,29,0.55)_100%)] pointer-events-none" aria-hidden="true"></div>
    {%- elsif section.settings.show_placeholder -%}
      <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
        <div class="w-[40%] max-w-[520px]" data-dc-hero-media>
          <div class="relative aspect-[16/10] bg-bg/5 flex items-center justify-center">
            <span class="font-mono text-[10px] tracking-[0.14em] uppercase text-gold text-center px-4">
              {{ section.settings.placeholder_label | default: 'hero — the collection on gold' }}
            </span>
          </div>
        </div>
      </div>
    {%- endif -%}

    <div class="relative z-[1] w-full max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 pb-10 md:pb-[80px]">
      {%- if eyebrow != blank -%}
        <p class="font-body text-[10px] tracking-[0.3em] uppercase text-bg/75 m-0" data-dc-hero-eyebrow>
          {{ eyebrow }}
        </p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h1
          class="font-display font-normal text-[42px] md:text-[62px] leading-[1.06] text-bg mt-[22px] mb-0 max-w-[20ch]"
          data-dc-hero-title
        >
          {{ heading }}
        </h1>
      {%- endif -%}
      {%- if tagline != blank -%}
        <p class="mt-[22px] font-body text-[15px] leading-[1.8] text-bg/85 max-w-[46ch] m-0" data-dc-hero-copy>
          {{ tagline }}
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "About hero",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dévoué de Nature" },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Redefining skincare — with purpose, with you."
    },
    { "type": "image_picker", "id": "image", "label": "Hero image (full-bleed cover)" },
    { "type": "checkbox", "id": "show_placeholder", "label": "Show image placeholder", "default": true },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "hero — the collection on gold"
    }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}
