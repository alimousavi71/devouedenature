{%- comment -%}
  About hero — Downloads/.../About.dc.html
{%- endcomment -%}
{%- liquid
  assign eyebrow = section.settings.eyebrow | default: 'About'
  assign heading = section.settings.heading | default: shop.name
  assign tagline = section.settings.tagline
-%}

{%- unless section.settings.hide_section -%}
  <section
    class="relative min-h-[78vh] flex items-end overflow-hidden bg-[linear-gradient(165deg,#30271D_0%,#5B4933_52%,#DBB281_100%)]"
    data-dc-about-hero
    data-reveal
  >
    <div class="absolute inset-0 flex items-center justify-center pointer-events-none" aria-hidden="true">
      {%- if section.settings.image != blank -%}
        <div class="w-[40%] max-w-[520px]">
          <div class="relative aspect-[16/10] overflow-hidden">
            {{
              section.settings.image
              | image_url: width: 1200
              | image_tag:
                loading: 'eager',
                class: 'absolute inset-0 w-full h-full object-cover opacity-80',
                alt: heading,
                widths: '600, 900, 1200'
            }}
          </div>
        </div>
      {%- elsif section.settings.show_placeholder -%}
        <div class="w-[40%] max-w-[520px]">
          <div class="relative aspect-[16/10] bg-bg/5 flex items-center justify-center">
            <span class="font-mono text-[10px] tracking-[0.14em] uppercase text-gold text-center px-4">
              {{ section.settings.placeholder_label | default: 'hero — the collection on gold' }}
            </span>
          </div>
        </div>
      {%- endif -%}
    </div>

    <div class="relative z-[1] w-full max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 pb-10 md:pb-[80px]" data-reveal-stagger>
      {%- if eyebrow != blank -%}
        <p class="font-body text-[10px] tracking-[0.3em] uppercase text-bg/75 m-0">{{ eyebrow }}</p>
      {%- endif -%}
      {%- if heading != blank -%}
        <h1 class="font-display font-normal text-[42px] md:text-[62px] leading-[1.06] text-bg mt-[22px] mb-0 max-w-[20ch]">
          {{ heading }}
        </h1>
      {%- endif -%}
      {%- if tagline != blank -%}
        <p class="mt-[22px] font-body text-[15px] leading-[1.8] text-bg/85 max-w-[46ch] m-0">{{ tagline }}</p>
      {%- endif -%}
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "About hero",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "About" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Dévoué de Nature" },
    {
      "type": "textarea",
      "id": "tagline",
      "label": "Tagline",
      "default": "Redefining skincare — with purpose, with you."
    },
    { "type": "image_picker", "id": "image", "label": "Hero image (optional)" },
    { "type": "checkbox", "id": "show_placeholder", "label": "Show image placeholder", "default": true },
    {
      "type": "text",
      "id": "placeholder_label",
      "label": "Placeholder label",
      "default": "hero — the collection on gold"
    }
  ],
  "presets": [{ "name": "About hero" }]
}
{% endschema %}
