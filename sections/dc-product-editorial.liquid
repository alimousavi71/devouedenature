{%- comment -%}
  Editorial story band — redesign/Product.dc.html
  Theme editor: section settings. Product admin: custom.editorial_lead, custom.editorial_body, custom.editorial_image
{%- endcomment -%}

{%- liquid
  assign lead = section.settings.lead
  if product.metafields.custom.editorial_lead != blank
    assign lead = product.metafields.custom.editorial_lead.value | default: product.metafields.custom.editorial_lead
  endif

  assign story_image = section.settings.image
  if product.metafields.custom.editorial_image != blank
    assign story_image = product.metafields.custom.editorial_image.value | default: product.metafields.custom.editorial_image
  endif

  assign use_metafield_body = false
  if product.metafields.custom.editorial_body != blank
    assign use_metafield_body = true
  endif
-%}

{%- capture editorial_body_html -%}
  {%- if use_metafield_body -%}
    {{ product.metafields.custom.editorial_body | metafield_tag }}
  {%- elsif section.settings.body != blank -%}
    {{ section.settings.body }}
  {%- endif -%}
{%- endcapture -%}

{%- liquid
  assign editorial_body_html = editorial_body_html | strip
  assign editorial_inner = editorial_body_html | replace: '<div class="metafield-rich_text_field">', '' | replace: '</div>', '' | strip
  assign editorial_inner = editorial_inner | replace: '<br />', '<br>' | replace: '<br/>', '<br>' | replace: '<br >', '<br>'

  assign editorial_split = false
  assign editorial_col_left = ''
  assign editorial_col_right = ''

  if editorial_inner contains '<br>'
    assign editorial_parts = editorial_inner | split: '<br>'
    assign editorial_part_count = 0
    for part in editorial_parts
      assign part_clean = part | strip | replace: '<p>', '' | replace: '</p>', '' | strip
      if part_clean != blank
        assign editorial_part_count = editorial_part_count | plus: 1
      endif
    endfor

    if editorial_part_count >= 2
      assign editorial_split = true
      assign editorial_mid = editorial_part_count | plus: 1 | divided_by: 2
      assign editorial_seen = 0
      for part in editorial_parts
        assign part_clean = part | strip | replace: '<p>', '' | replace: '</p>', '' | strip
        if part_clean != blank
          assign editorial_seen = editorial_seen | plus: 1
          assign part_wrapped = '<p>' | append: part_clean | append: '</p>'
          if editorial_seen <= editorial_mid
            assign editorial_col_left = editorial_col_left | append: part_wrapped
          else
            assign editorial_col_right = editorial_col_right | append: part_wrapped
          endif
        endif
      endfor
    endif
  endif

  if editorial_split == false
    assign editorial_compact = editorial_inner | strip_newlines
    assign editorial_marked = editorial_compact | replace: '</p><p', '</p><!--DCCOL--><p' | replace: '</p> <p', '</p><!--DCCOL--><p'
    if editorial_marked contains '<!--DCCOL-->'
      assign editorial_parts = editorial_marked | split: '<!--DCCOL-->'
      assign editorial_part_count = editorial_parts.size
      if editorial_part_count >= 2
        assign editorial_split = true
        assign editorial_mid = editorial_part_count | plus: 1 | divided_by: 2
        for part in editorial_parts
          assign part_clean = part | strip
          if part_clean != blank
            unless part_clean contains '<p'
              assign part_clean = '<p>' | append: part_clean
            endunless
            unless part_clean contains '</p>'
              assign part_clean = part_clean | append: '</p>'
            endunless
            if forloop.index <= editorial_mid
              assign editorial_col_left = editorial_col_left | append: part_clean
            else
              assign editorial_col_right = editorial_col_right | append: part_clean
            endif
          endif
        endfor
      endif
    endif
  endif
-%}

{%- unless section.settings.hide_section -%}
  {%- if lead != blank or editorial_body_html != blank or story_image != blank -%}
    <section class="max-w-page mx-auto px-[16px] md:px-[24px] xl:px-5 pb-[48px] md:pb-[90px] xl:pb-[130px] overflow-x-clip">
      <div class="min-w-0" data-reveal-stagger>
        {%- if lead != blank -%}
          <p class="m-0 mx-auto text-center font-display font-normal text-[20px] md:text-[27px] leading-[1.45] md:leading-[1.5] text-pretty text-ink max-w-[42ch]">
            {{ lead }}
          </p>
        {%- endif -%}

        {%- if editorial_body_html != blank -%}
          {%- if editorial_split and editorial_col_left != blank and editorial_col_right != blank -%}
            <div class="dc-prose dc-product-editorial__body mt-[22px] md:mt-[40px] font-body text-[13px] md:text-body leading-[1.8] md:leading-[1.9] text-secondary grid grid-cols-1 md:grid-cols-2 md:gap-x-[44px] gap-y-[12px] md:gap-y-0 md:items-start [&_p]:mt-0 [&_p]:mb-0">
              <div class="min-w-0 text-pretty">{{ editorial_col_left }}</div>
              <div class="min-w-0 text-pretty">{{ editorial_col_right }}</div>
            </div>
          {%- else -%}
            <div class="dc-prose dc-product-editorial__body mt-[22px] md:mt-[40px] font-body text-[13px] md:text-body leading-[1.8] md:leading-[1.9] text-secondary columns-1 md:columns-2 md:gap-[44px] [column-fill:balance] [&_p]:mt-0 [&_p]:mb-3 md:[&_p]:mb-4 [&_p:last-child]:mb-0">
              {{ editorial_body_html }}
            </div>
          {%- endif -%}
        {%- endif -%}

        {%- if story_image != blank -%}
          <div class="mt-[28px] md:mt-[46px] relative aspect-[16/10] md:aspect-[21/9] overflow-hidden bg-[repeating-linear-gradient(135deg,#EFE7DA_0_16px,#F8F3E8_16px_32px)]">
            {{
              story_image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                class: 'absolute inset-0 w-full h-full object-cover',
                alt: lead | default: product.title,
                widths: '800, 1200, 1600'
            }}
          </div>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}
{%- endunless -%}

{% schema %}
{
  "name": "Product story",
  "settings": [
    {
      "type": "checkbox",
      "id": "hide_section",
      "label": "Hide section",
      "default": false
    },
    {
      "type": "textarea",
      "id": "lead",
      "label": "Lead quote",
      "default": "Proudly developed and made in Canada — formulas that bring together thoughtful ingredient selection, scientific expertise, and rigorous attention to quality.",
      "info": "Per-product override: metafield custom.editorial_lead"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Every detail is considered with purpose: high-performance actives chosen for results, balanced compositions designed to feel refined on the skin, and a sensorial experience that supports your daily ritual.</p><p>From cleanser to cream, each product is crafted to deliver meaningful results — never aggressive, always intentional.</p>",
      "info": "Per-product override: metafield custom.editorial_body (rich text). Use a line break or two paragraphs for even columns."
    },
    { "type": "header", "content": "Story image" },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Optional. Per-product override: metafield custom.editorial_image. Hidden when empty."
    }
  ],
  "presets": [{ "name": "Product story" }]
}
{% endschema %}
