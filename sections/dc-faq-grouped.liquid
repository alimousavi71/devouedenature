{%- comment -%}
  Grouped FAQ page — redesign/FAQ.dc.html: questions under H2 group headings,
  sticky left "Groups" index, contact link. Used by templates/page.faqs.json.
  Flat accordion for Home/Contact lives in sections/dc-faq.liquid.
{%- endcomment -%}

{%- liquid
  assign groups = ''
  for block in section.blocks
    if block.type == 'question'
      assign g = block.settings.group_name | default: 'General'
      unless groups contains g
        assign groups = groups | append: g | append: '||'
      endunless
    endif
  endfor
  assign group_list = groups | split: '||'
-%}

<header class="max-w-page mx-auto px-5 md:px-10 pt-10 md:pt-[70px] grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-[100px] md:items-end" data-reveal="1">
  <div>
    {%- if section.settings.eyebrow != blank -%}
      <p class="font-mono text-caption uppercase text-muted">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="font-display text-h1 mt-2 md:mt-[18px]">{{ section.settings.heading | default: 'Common questions' }}</h1>
  </div>
  {%- if section.settings.intro != blank -%}
    <p class="font-body text-body text-secondary max-w-[52ch]">{{ section.settings.intro }}</p>
  {%- endif -%}
</header>

<div class="max-w-page mx-auto px-5 md:px-10 py-10 md:py-[70px] md:pb-[120px] grid grid-cols-1 md:grid-cols-[280px_minmax(0,1fr)] gap-8 md:gap-[90px] items-start">
  <aside class="hidden md:block md:sticky md:top-[120px] border-t border-ink pt-5">
    <div class="font-mono text-caption uppercase text-muted">{{ 'sections.faq.groups' | t | default: 'Groups' }}</div>
    <div class="mt-5 flex flex-col">
      {%- for g in group_list -%}
        <a href="#{{ g | handle }}" class="py-3 border-b border-divider font-body text-nav uppercase text-ink hover:text-secondary transition-colors duration-fast ease-fast">
          {{ g }}
        </a>
      {%- endfor -%}
    </div>
    {%- if section.settings.contact_url != blank -%}
      <a href="{{ section.settings.contact_url }}" class="inline-block mt-7 font-mono text-caption uppercase border-b border-ink pb-1">
        {{ section.settings.contact_label | default: 'Still stuck? Write to us' }}
      </a>
    {%- endif -%}
  </aside>

  <div>
    {%- for g in group_list -%}
      <div id="{{ g | handle }}" {% unless forloop.first %}class="mt-[70px]"{% endunless %}>
        <h2 class="font-display text-h3 mb-6">{{ g }}</h2>
        <div class="border-t border-ink">
          {%- for block in section.blocks -%}
            {%- assign group_name = block.settings.group_name | default: 'General' -%}
            {%- if block.type == 'question' and group_name == g -%}
              {% render 'dc-accordion', heading: block.settings.question, body: block.settings.answer %}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}

    {%- if group_list == empty or group_list == blank -%}
      <p class="font-body text-body text-secondary">{{ 'sections.faq.empty' | t | default: 'No questions have been added yet.' }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ (grouped)",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common questions" },
    { "type": "textarea", "id": "intro", "label": "Intro text" },
    { "type": "url", "id": "contact_url", "label": "Contact link URL" },
    { "type": "text", "id": "contact_label", "label": "Contact link label", "default": "Still stuck? Write to us" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "group_name", "label": "Group", "default": "General" },
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ (grouped)",
      "blocks": [
        { "type": "question", "settings": { "group_name": "Orders and delivery" } },
        { "type": "question", "settings": { "group_name": "Products" } }
      ]
    }
  ]
}
{% endschema %}
