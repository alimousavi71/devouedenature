{%- comment -%}
  Activate-account form — matches dc-customer-* auth pages.
{%- endcomment -%}

<div class="max-w-page mx-auto px-4 md:px-6 py-7 md:py-8">
  <div class="max-w-md mx-auto">
    <h1 class="font-display text-h2 mb-2">{{ 'customer.activate_account.title' | t }}</h1>
    <p class="font-body text-body text-secondary mb-6">{{ 'customer.activate_account.subtext' | t }}</p>

    {%- form 'activate_customer_password' -%}
      {%- if form.errors -%}
        <p class="font-body text-body-sm text-error mb-4" role="alert">{{ form.errors | default_errors }}</p>
      {%- endif -%}

      <div class="mb-4">
        <label for="dc-ActivatePassword" class="block font-mono text-label uppercase text-muted mb-2">
          {{ 'customer.activate_account.password' | t }}
        </label>
        <input
          type="password"
          name="customer[password]"
          id="dc-ActivatePassword"
          autocomplete="new-password"
          class="w-full border border-border bg-bg px-3 py-3 font-body text-body text-ink focus:outline-none focus:border-ink"
        >
      </div>

      <div class="mb-6">
        <label for="dc-ActivatePasswordConfirm" class="block font-mono text-label uppercase text-muted mb-2">
          {{ 'customer.activate_account.password_confirm' | t }}
        </label>
        <input
          type="password"
          name="customer[password_confirmation]"
          id="dc-ActivatePasswordConfirm"
          autocomplete="new-password"
          class="w-full border border-border bg-bg px-3 py-3 font-body text-body text-ink focus:outline-none focus:border-ink"
        >
      </div>

      {%- assign btn_label = 'customer.activate_account.submit' | t -%}
      {% render 'dc-button', text: btn_label, variant: 'filled', sweep: true, type: 'submit' %}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Activate account",
  "settings": []
}
{% endschema %}
