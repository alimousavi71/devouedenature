{%- comment -%}
  About closing CTA — Discover your ritual
{%- endcomment -%}

{%- unless section.settings.hide_section -%}
  <section class="max-w-page mx-auto px-[20px] md:px-[24px] xl:px-5 py-[64px] md:py-[90px] xl:py-[130px] text-center" data-reveal-stagger>
    {%- if section.settings.heading != blank -%}
      <h2 class="font-display font-normal text-[36px] md:text-[46px] text-ink m-0">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="mt-5 mx-auto max-w-[52ch] font-body text-[14px] leading-[1.9] text-secondary m-0">{{ section.settings.text }}</p>
    {%- endif -%}
    <div class="mt-10 flex flex-wrap gap-3 justify-center">
      {%- if section.settings.primary_label != blank -%}
        {% render 'dc-button',
          text: section.settings.primary_label,
          url: section.settings.primary_url,
          variant: 'filled',
          sweep: true,
          class: 'h-[54px] px-10 text-[11px] tracking-[0.24em]'
        %}
      {%- endif -%}
      {%- if section.settings.secondary_label != blank -%}
        {% render 'dc-button',
          text: section.settings.secondary_label,
          url: section.settings.secondary_url,
          variant: 'outline',
          class: 'h-[54px] px-10 text-[11px] tracking-[0.24em]'
        %}
      {%- endif -%}
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "About CTA",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Discover your ritual."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Begin with the formula your skin is asking for."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary button label",
      "default": "Shop the collection"
    },
    { "type": "url", "id": "primary_url", "label": "Primary button URL" },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary button label",
      "default": "Speak to us"
    },
    { "type": "url", "id": "secondary_url", "label": "Secondary button URL" }
  ],
  "presets": [{ "name": "About CTA" }]
}
{% endschema %}
