{%- comment -%}
  About science band — dark ink with numbered cards + campaign scrub
{%- endcomment -%}

{%- unless section.settings.hide_section -%}
  <section
    class="bg-ink text-bg mt-[48px] md:mt-[90px] xl:mt-[130px] py-[48px] md:py-[90px] xl:py-[120px] px-[20px] md:px-[24px] xl:px-5"
    data-dc-campaign
  >
    <div class="max-w-page mx-auto">
      <header class="text-center">
        {%- if section.settings.heading != blank -%}
          <h2 class="font-display font-normal text-[26px] md:text-[42px] text-bg m-0" data-dc-campaign-inner>
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="mt-[18px] md:mt-[22px] mx-auto max-w-[68ch] font-body text-[14px] leading-[1.8] md:leading-[1.9] text-gold m-0" data-dc-campaign-copy>
            {{ section.settings.intro }}
          </p>
        {%- endif -%}
      </header>

      {%- if section.blocks.size > 0 -%}
        <div class="mt-[34px] md:mt-[70px] grid grid-cols-1 md:grid-cols-3 gap-[22px] md:gap-[40px]" data-reveal-stagger>
          {%- for block in section.blocks -%}
            {%- liquid
              assign card_overlay = block.settings.overlay_opacity | default: 70
              assign card_overlay_decimal = card_overlay | times: 0.01
            -%}
            <article
              class="relative overflow-hidden min-h-[220px] md:min-h-[320px]"
              data-dc-lift-hover
              {{ block.shopify_attributes }}
            >
              <div class="absolute inset-0" aria-hidden="true">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 900
                    | image_tag:
                      loading: 'lazy',
                      class: 'absolute inset-0 w-full h-full object-cover',
                      alt: '',
                      widths: '400, 600, 900'
                  }}
                  <div
                    class="absolute inset-0 bg-[#211A13]"
                    style="opacity: {{ card_overlay_decimal }};"
                  ></div>
                {%- else -%}
                  <div class="absolute inset-0 bg-[#211A13]"></div>
                {%- endif -%}
              </div>

              <div class="relative z-[1] h-full min-h-[inherit] flex flex-col justify-between px-[20px] py-[28px] md:px-10 md:py-[56px]">
                {%- if block.settings.number != blank -%}
                  <p class="font-mono text-[10px] tracking-[0.18em] text-gold m-0">{{ block.settings.number }}</p>
                {%- endif -%}
                <div>
                  {%- if block.settings.title != blank -%}
                    <h3 class="font-display font-normal text-[22px] md:text-[26px] leading-[1.25] text-bg m-0">{{ block.settings.title }}</h3>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <p class="mt-4 font-body text-[13px] leading-[1.85] text-gold max-w-[32ch] m-0">{{ block.settings.text }}</p>
                  {%- endif -%}
                </div>
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.closing != blank -%}
        <p class="mt-[40px] md:mt-[60px] mx-auto max-w-[72ch] text-center font-body text-[14px] leading-[1.9] text-gold m-0" data-reveal>
          {{ section.settings.closing }}
        </p>
      {%- endif -%}
    </div>
  </section>
{%- endunless -%}

{% schema %}
{
  "name": "About science",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "hide_section", "label": "Hide section", "default": false },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Science-Led, Nature-Inspired"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro",
      "default": "Our formulations are developed using evidence-based research, modern cosmetic chemistry, and clinically informed active selection. We prioritize:"
    },
    {
      "type": "textarea",
      "id": "closing",
      "label": "Closing line",
      "default": "Each formula is developed and tested in Canada to ensure safety, stability, and real performance — because results should be as real as the promise."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Science card",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "High Performance Actives" },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Concentrations chosen for the result, not the label."
        },
        { "type": "image_picker", "id": "image", "label": "Background image" },
        {
          "type": "range",
          "id": "overlay_opacity",
          "label": "Image overlay darkness",
          "min": 0,
          "max": 90,
          "step": 5,
          "default": 70,
          "unit": "%",
          "info": "Darkens the photo so text stays readable."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About science",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "number": "01",
            "title": "High Performance Actives",
            "text": "Concentrations chosen for the result, not the label."
          }
        },
        {
          "type": "card",
          "settings": {
            "number": "02",
            "title": "Gentle on Skin",
            "text": "Tested for tolerance before it is tested for effect."
          }
        },
        {
          "type": "card",
          "settings": {
            "number": "03",
            "title": "Balanced Compositions",
            "text": "Nothing carried in the formula that does not earn its place."
          }
        }
      ]
    }
  ]
}
{% endschema %}
